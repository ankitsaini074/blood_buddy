<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
        <!-- Profile Header -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-outline-variant">
            <!-- Banner -->
            <div class="h-32 bg-gradient-to-r from-secondary to-secondary-container"></div>

            <!-- Profile Info -->
            <div class="px-6 md:px-10 pb-8">
                <div class="flex flex-col md:flex-row items-start md:items-end -mt-16 gap-6">
                    <!-- Profile Image -->
                    <div class="relative">
                        <div class="w-32 h-32 rounded-full border-4 border-surface-container-lowest overflow-hidden shadow-lg bg-surface-container-low">
                            <% var file = 'uploads/' + hospital.profilePic; %>
                            <img src="<%= file %>" alt="Hospital Logo" class="w-full h-full object-cover">
                        </div>
                        <span class="absolute bottom-2 right-2 w-6 h-6 bg-secondary rounded-full border-4 border-white"></span>
                    </div>

                    <!-- Name & Status -->
                    <div class="flex-1">
                        <h1 class="text-h2 text-on-surface mb-2"><%= hospital.name %></h1>
                        <p class="text-body-md text-on-surface-variant">@<%= hospital.local.username %></p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex flex-wrap gap-3">
                        <a href="/editHospDatabase" class="inline-flex items-center px-6 py-3 bg-tertiary text-on-tertiary rounded-lg font-label-md hover:bg-on-tertiary-container transition-colors shadow-md shadow-tertiary/20 gap-2">
                            <span class="material-symbols-outlined">inventory_2</span>
                            Blood Inventory
                        </a>
                        <a href="/editHospital" class="inline-flex items-center px-6 py-3 bg-secondary text-on-secondary rounded-lg font-label-md hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-secondary/20 gap-2">
                            <span class="material-symbols-outlined">edit</span>
                            Edit Profile
                        </a>
                        <a href="/auth/logout" class="inline-flex items-center px-6 py-3 bg-surface-container-low text-on-surface rounded-lg font-label-md hover:bg-surface-container transition-colors gap-2">
                            <span class="material-symbols-outlined">logout</span>
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
            <!-- Contact Info -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-secondary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-secondary">contact_phone</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">Contact Information</h3>
                </div>
                <div class="space-y-4">
                    <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                        <span class="text-body-md text-on-surface-variant">Email</span>
                        <span class="text-body-md text-on-surface font-medium"><%= hospital.email %></span>
                    </div>
                    <div class="flex justify-between items-center py-3">
                        <span class="text-body-md text-on-surface-variant">Contact Number</span>
                        <span class="text-body-md text-on-surface font-medium"><%= hospital.contactNumber %></span>
                    </div>
                </div>
            </div>

            <!-- Location Info -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-tertiary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-tertiary">location_on</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">Location</h3>
                </div>
                <div class="space-y-4">
                    <div class="flex justify-between items-center py-3">
                        <span class="text-body-md text-on-surface-variant">City</span>
                        <span class="text-body-md text-on-surface font-medium"><%= hospital.city %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Card -->
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6 mt-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary">business</span>
                </div>
                <h3 class="text-h3 text-on-surface">Hospital Address</h3>
            </div>
            <p class="text-body-md text-on-surface"><%= hospital.address %></p>
        </div>

        <!-- Quick Actions -->
        <div class="bg-gradient-to-r from-secondary/5 to-tertiary/5 rounded-xl border border-outline-variant p-6 mt-6">
            <h3 class="text-h3 text-on-surface mb-4">Quick Actions</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <a href="/editHospDatabase" class="flex flex-col items-center p-4 bg-white rounded-lg hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-tertiary/10 rounded-full flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-tertiary">inventory_2</span>
                    </div>
                    <span class="text-label-md text-on-surface">Manage Blood Stock</span>
                </a>
                <a href="/editHospital" class="flex flex-col items-center p-4 bg-white rounded-lg hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-secondary">edit</span>
                    </div>
                    <span class="text-label-md text-on-surface">Update Profile</span>
                </a>
                <a href="/searchHospital" class="flex flex-col items-center p-4 bg-white rounded-lg hover:shadow-md transition-shadow">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-primary">search</span>
                    </div>
                    <span class="text-label-md text-on-surface">Find Donors</span>
                </a>
                <button onclick="document.getElementById('postCampModal').classList.remove('hidden')"
                    class="flex flex-col items-center p-4 bg-white rounded-lg hover:shadow-md transition-shadow text-left w-full">
                    <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-secondary">event</span>
                    </div>
                    <span class="text-label-md text-on-surface">Post Blood Camp</span>
                </button>
                <button onclick="document.getElementById('postNeedModal').classList.remove('hidden')"
                    class="flex flex-col items-center p-4 bg-white rounded-lg hover:shadow-md transition-shadow text-left w-full">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-3">
                        <span class="material-symbols-outlined text-primary">bloodtype</span>
                    </div>
                    <span class="text-label-md text-on-surface">Post Bulk Blood Need</span>
                </button>
            </div>
        </div>

        <!-- My Camps -->
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6 mt-6">
            <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-secondary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-secondary">event</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">My Blood Camps</h3>
                </div>
                <a href="/camps" class="text-xs text-secondary hover:underline flex items-center gap-1">
                    View public page <span class="material-symbols-outlined text-sm">open_in_new</span>
                </a>
            </div>
            <% if (!myCamps || myCamps.length === 0) { %>
            <p class="text-sm text-on-surface-variant text-center py-6">No camps posted yet. Use "Post Blood Camp" above to create one.</p>
            <% } else { %>
            <div class="space-y-3">
                <% myCamps.forEach(function(c) { %>
                <div class="flex items-center justify-between p-4 bg-surface-container-low rounded-xl border border-outline-variant/40">
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-on-surface text-sm truncate"><%= c.title %></p>
                        <p class="text-xs text-on-surface-variant mt-0.5">
                            <%= new Date(c.date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %> · <%= c.city %>
                        </p>
                    </div>
                    <span class="ml-3 px-2.5 py-1 rounded-full text-xs font-semibold capitalize
                        <%= c.status === 'upcoming' ? 'bg-green-50 text-green-700' : c.status === 'completed' ? 'bg-secondary/10 text-secondary' : 'bg-gray-100 text-gray-500' %>">
                        <%= c.status %>
                    </span>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>

        <!-- My Bulk Blood Needs -->
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6 mt-6">
            <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">bloodtype</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">My Bulk Blood Needs</h3>
                </div>
                <a href="/hospital-needs" class="text-xs text-secondary hover:underline flex items-center gap-1">
                    View public page <span class="material-symbols-outlined text-sm">open_in_new</span>
                </a>
            </div>
            <% if (!myNeeds || myNeeds.length === 0) { %>
            <p class="text-sm text-on-surface-variant text-center py-6">No bulk needs posted yet.</p>
            <% } else { %>
            <div class="space-y-3">
                <% myNeeds.forEach(function(n) { %>
                <div class="flex items-center justify-between p-4 bg-surface-container-low rounded-xl border border-outline-variant/40">
                    <div class="flex-1 min-w-0 flex items-center gap-3">
                        <span class="px-2.5 py-1 bg-primary/10 text-primary rounded-lg text-xs font-bold flex-shrink-0"><%= n.bloodGroup %></span>
                        <div>
                            <p class="font-semibold text-on-surface text-sm"><%= n.unitsNeeded %> unit<%= n.unitsNeeded !== 1 ? 's' : '' %> needed</p>
                            <p class="text-xs text-on-surface-variant capitalize"><%= n.urgency %> · <%= new Date(n.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) %></p>
                        </div>
                    </div>
                    <span class="ml-3 px-2.5 py-1 rounded-full text-xs font-semibold capitalize
                        <%= n.status === 'open' ? 'bg-green-50 text-green-700' : n.status === 'fulfilled' ? 'bg-secondary/10 text-secondary' : 'bg-gray-100 text-gray-500' %>">
                        <%= n.status %>
                    </span>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </div>
</main>

<!-- Post Camp Modal -->
<div id="postCampModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-8 relative max-h-[90vh] overflow-y-auto">
        <button onclick="document.getElementById('postCampModal').classList.add('hidden')"
            class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-secondary/10 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-secondary">event</span>
            </div>
            <h2 class="text-h2 text-on-surface">Post a Blood Camp</h2>
        </div>
        <form action="/camps/new" method="POST" class="space-y-4">
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Camp Title *</label>
                <input type="text" name="title" required placeholder="e.g. Annual Blood Donation Drive 2026"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Start Date *</label>
                    <input type="date" name="date" required
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">End Date (optional)</label>
                    <input type="date" name="endDate"
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
                </div>
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">City *</label>
                <input type="text" name="city" required value="<%= hospital.city || '' %>"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Venue / Address *</label>
                <input type="text" name="address" required placeholder="Hall or building name"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Contact Number *</label>
                <input type="tel" name="contactNumber" required value="<%= hospital.contactNumber || '' %>"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Description (optional)</label>
                <textarea name="description" rows="2" placeholder="Details for donors…"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-secondary text-on-secondary rounded-xl font-semibold hover:opacity-90 transition-all">
                Post Camp
            </button>
        </form>
    </div>
</div>

<!-- Post Bulk Need Modal -->
<div id="postNeedModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-8 relative">
        <button onclick="document.getElementById('postNeedModal').classList.add('hidden')"
            class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">bloodtype</span>
            </div>
            <h2 class="text-h2 text-on-surface">Post Bulk Blood Need</h2>
        </div>
        <form action="/hospital-needs/new" method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Blood Group *</label>
                    <select name="bloodGroup" required
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="">Select</option>
                        <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                        <option>B+</option><option>B-</option><option>A1B+</option><option>A1B-</option>
                        <option>A2B+</option><option>A2B-</option><option>AB+</option><option>AB-</option>
                        <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Units Needed *</label>
                    <input type="number" name="unitsNeeded" min="1" required placeholder="e.g. 5"
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Urgency *</label>
                    <select name="urgency" required
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="normal">Normal</option>
                        <option value="urgent">Urgent</option>
                        <option value="critical">Critical</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Needed By</label>
                    <input type="date" name="deadline"
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                </div>
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Contact Number</label>
                <input type="tel" name="contactNumber" value="<%= hospital.contactNumber || '' %>"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Notes</label>
                <textarea name="notes" rows="2" placeholder="Reason, special requirements…"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-primary text-on-primary rounded-xl font-semibold hover:opacity-90 transition-all">
                Post Blood Need
            </button>
        </form>
    </div>
</div>

<% include partials/footer %>
