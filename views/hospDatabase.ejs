                </div>
            </div>

            <!-- A1B+ -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-h3 text-on-surface font-semibold">A1B+</span>
                    <span class="w-8 h-8 bg-tertiary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-tertiary text-lg">bloodtype</span>
                    </span>
                </div>
                <div class="bg-surface-container-low rounded-lg py-3 px-2 text-center">
                    <span class="text-body-lg text-on-surface font-medium"><%= data.A1B || '0' %> units</span>
                </div>
            </div>

            <!-- A1B- -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-h3 text-on-surface font-semibold">A1B-</span>
                    <span class="w-8 h-8 bg-tertiary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-tertiary text-lg">bloodtype</span>
                    </span>
                </div>
                <div class="bg-surface-container-low rounded-lg py-3 px-2 text-center">
