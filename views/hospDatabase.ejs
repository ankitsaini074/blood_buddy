<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-h1 text-on-surface mb-2">Blood Inventory</h1>
                <p class="text-body-md text-on-surface-variant">Current blood stock levels at your hospital</p>
            </div>
            <a href="/editHospDatabase" class="inline-flex items-center px-6 py-3 bg-secondary text-on-secondary rounded-lg font-label-md hover:bg-on-secondary-container transition-colors gap-2">
                <span class="material-symbols-outlined">edit</span>
                Update Inventory
            </a>
        </div>

        <!-- Blood Type Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
            <!-- A+ -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-h3 text-on-surface font-semibold">A+</span>
                    <span class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-lg">bloodtype</span>
                    </span>
                </div>
                <div class="bg-surface-container-low rounded-lg py-3 px-2 text-center">
                    <span class="text-body-lg text-on-surface font-medium"><%= data.A || '0' %> units</span>
                </div>
            </div>

            <!-- A- -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-h3 text-on-surface font-semibold">A-</span>
                    <span class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary text-lg">bloodtype</span>
                    </span>
                </div>
                <div class="bg-surface-container-low rounded-lg py-3 px-2 text-center">
                    <span class="text-body-lg text-on-surface font-medium"><%= data.A_ || '0' %> units</span>
                </div>
            </div>

            <!-- B+ -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-h3 text-on-surface font-semibold">B+</span>
                    <span class="w-8 h-8 bg-secondary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-secondary text-lg">bloodtype</span>
                    </span>
                </div>
                <div class="bg-surface-container-low rounded-lg py-3 px-2 text-center">
                    <span class="text-body-lg text-on-surface font-medium"><%= data.B || '0' %> units</span>
                </div>
            </div>

            <!-- B- -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-h3 text-on-surface font-semibold">B-</span>
                    <span class="w-8 h-8 bg-secondary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-secondary text-lg">bloodtype</span>
                    </span>
                </div>
                <div class="bg-surface-container-low rounded-lg py-3 px-2 text-center">
                    <span class="text-body-lg text-on-surface font-medium"><%= data.B_ || '0' %> units</span>
                </div>
            </div>

            <!-- AB+ -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-h3 text-on-surface font-semibold">AB+</span>
