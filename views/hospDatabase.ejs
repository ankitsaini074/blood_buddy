        <!-- Summary Card -->
        <div class="bg-gradient-to-r from-secondary/5 to-tertiary/5 rounded-xl border border-outline-variant p-6 mt-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 bg-secondary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-secondary text-2xl">inventory_2</span>
                    </div>
                    <div>
                        <h3 class="text-h3 text-on-surface">Total Blood Units</h3>
                        <p class="text-caption text-on-surface-variant">Combined across all blood types</p>
                    </div>
                </div>
                <div class="text-center">
                    <p class="text-[40px] font-extrabold text-secondary">
                        <% const sum = (parseInt(data.A || '0') || 0) +
                           (parseInt(data.A_ || '0') || 0) +
                           (parseInt(data.B || '0') || 0) +
                           (parseInt(data.B_ || '0') || 0) +
                           (parseInt(data.AB || '0') || 0) +
                           (parseInt(data.AB_ || '0') || 0) +
                           (parseInt(data.O || '0') || 0) +
                           (parseInt(data.O_ || '0') || 0) +
                           (parseInt(data.A1 || '0') || 0) +
                           (parseInt(data.A1_ || '0') || 0) +
                           (parseInt(data.A2 || '0') || 0) +
                           (parseInt(data.A2_ || '0') || 0) +
                           (parseInt(data.A1B || '0') || 0) +
                           (parseInt(data.A1B_ || '0') || 0) +
                           (parseInt(data.A2B || '0') || 0) +
                           (parseInt(data.A2B_ || '0') || 0); %>
                        <%= sum %>
                    </p>
                    <p class="text-caption text-on-surface-variant">units available</p>
                </div>
            </div>
