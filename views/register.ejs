<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20 min-h-[calc(100vh-180px)] flex items-center justify-center">
    <div class="w-full max-w-6xl bg-surface-container-lowest rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.08)] overflow-hidden flex flex-col lg:flex-row">
        <!-- Left Panel - Benefits -->
        <div class="w-full lg:w-1/3 bg-primary-container p-8 md:p-12 text-on-primary-container flex flex-col justify-between relative overflow-hidden">
            <div class="relative z-10">
                <h2 class="text-h2 md:text-h1 mb-4 md:mb-6 text-white">Become a Donor</h2>
                <p class="text-body-md text-on-primary-container opacity-90 leading-relaxed">Register as a donor and join our mission to save lives. Your contribution can make the difference between life and death.</p>
            </div>
            <div class="mt-8 md:mt-12 space-y-5 md:space-y-6 relative z-10">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">volunteer_activism</span>
                    </div>
                    <span class="text-label-md text-white">Save Lives</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">track_changes</span>
                    </div>
                    <span class="text-label-md text-white">Track Donations</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">notifications_active</span>
                    </div>
                    <span class="text-label-md text-white">Get Urgent Alerts</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center">
                        <span class="material-symbols-outlined text-white">diversity_3</span>
                    </div>
                    <span class="text-label-md text-white">Join Community</span>
                </div>
            </div>
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-48 h-48 bg-white/10 rounded-full blur-2xl"></div>
        </div>

        <!-- Right Panel - Registration Form -->
        <div class="w-full lg:w-2/3 p-6 md:p-12">
            <form action="/auth/register" id="donor-form" class="space-y-6" method="POST" enctype="multipart/form-data">
                <!-- Profile Upload -->
                <div class="flex flex-col items-center mb-6">
                    <div class="relative group">
                        <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-surface-container flex items-center justify-center overflow-hidden border-2 border-dashed border-outline-variant hover:border-primary transition-colors cursor-pointer" id="profile-preview" onclick="document.getElementById('profilePic').click()">
                            <% if(currentUser && currentUser.profilePic) { %>
                                <img src="<%= currentUser.profilePic %>" alt="Profile" class="w-full h-full object-cover">
                            <% } else { %>
                                <span class="material-symbols-outlined text-3xl md:text-4xl text-outline-variant hover:text-primary">add_a_photo</span>
                            <% } %>
                        </div>
                        <span class="text-label-md mt-3 text-on-surface-variant">Upload Profile Photo</span>
                        <input type="file" name="profilePic" id="profilePic" accept="image/jpeg,image/jpg,image/png,image/gif" class="hidden" onchange="previewImage(this)">
                    </div>
                </div>

                <!-- Basic Info -->
                <div class="space-y-4">
                    <h3 class="text-h3 text-on-surface">Personal Information</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Full Name</label>
                            <input type="text" name="name" placeholder="John Doe" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Username</label>
                            <input type="text" id="username" name="username" placeholder="johndoe123" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Email Address</label>
                            <input type="email" id="email" name="email" placeholder="john@example.com" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Contact Number</label>
                            <input type="tel" id="phoneNumber" name="contactNumber" placeholder="+91 98765 43210" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                    </div>
                </div>

                <!-- Password & DOB -->
                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Password</label>
                            <input type="password" id="password" name="password" placeholder="•••••••••" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Confirm Password</label>
                            <input type="password" id="confirmPassword" placeholder="•••••••••" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Date of Birth</label>
                            <input type="date" name="dob" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Gender</label>
                            <select name="gender" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                <option value="">Select Gender</option>
                                <option value="M">Male</option>
                                <option value="F">Female</option>
                                <option value="O">Other</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Blood & Location Info -->
                <div class="space-y-4">
                    <h3 class="text-h3 text-on-surface">Blood & Location</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Blood Group</label>
                            <select name="bloodGroup" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                <option value="">Select Blood Group</option>
                                <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                                <option>B+</option><option>B-</option><option>A1B+</option><option>A1B-</option>
                                <option>A2B+</option><option>A2B-</option><option>AB+</option><option>AB-</option>
                                <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Last Donation Date</label>
                            <input type="date" name="dateOfLastDonation" class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="text-label-md text-on-surface-variant block">City</label>
                        <select name="city" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            <option value="">Select City</option>
                            <option>Agartala</option><option>Agra</option><option>Ahmedabad</option><option>Ahmednagar</option><option>Aizwal</option><option>Ajmer</option><option>Akola</option><option>Aligarh</option><option>Allahabad</option><option>Alwar</option><option>Ambala</option><option>Amravati</option><option>Amreli</option><option>Amritsar</option><option>Anand</option><option>Anantapur</option><option>Anklesvar</option><option>Anuppur</option><option>Araria</option><option>Arcot</option><option>Arrah</option><option>Aruppukkottai</option><option>Asansol</option><option>Ashok Nagar</option><option>Aurangabad</option><option>Azamgarh</option><option>Bahadurgarh</option><option>Baharampur</option><option>Bahraich</option><option>Balaghat</option><option>Balasore</option><option>Balia</option><option>Ballabhgarh</option><option>Ballarpur</option><option>Balrampur</option><option>Banda</option><option>Bangalore</option><option>Banswara</option><option>Bardhaman</option><option>Bareilly</option><option>Barmer</option><option>Barrackpur</option><option>Barwani</option><option>Beawar</option><option>Belgaum</option><option>Bellary</option><option>Bengaluru</option><option>Betul</option><option>Bhagalpur</option><option>Bhandara</option><option>Bharatpur</option><option>Bharuch</option><option>Bhavnagar</option><option>Bhilai Nagar</option><option>Bhimavaram</option><option>Bhiwandi</option><option>Bhopal</option><option>Bhubaneswar</option><option>Bhuj</option><option>Bidar</option><option>Bihar Sharif</option><option>Bikaner</option><option>Bilaspur</option><option>Bokaro Steel City</option><option>Bongaigaon</option><option>Bulandshahr</option><option>Buldana</option><option>Burhanpur</option><option>Buxar</option><option>Chandigarh</option><option>Chennai</option><option>Coimbatore</option><option>Cuttack</option><option>Dehradun</option><option>Delhi</option><option>Dhanbad</option><option>Dharwad</option><option>Dhule</option><option>Dibrugarh</option><option>Dispur</option><option>Durgapur</option><option>Ernakulam</option><option>Erode</option><option>Faridabad</option><option>Gandhinagar</option><option>Gangtok</option><option>Gaya</option><option>Ghaziabad</option><option>Goa Velha</option><option>Gorakhpur</option><option>Greater Noida</option><option>Gurgaon</option><option>Guwahati</option><option>Gwalior</option><option>Haridwar</option><option>Hisar</option><option>Howrah</option><option>Hubli</option><option>Hyderabad</option><option>Indore</option><option>Jabalpur</option><option>Jaipur</option><option>Jalandhar</option><option>Jammu</option><option>Jamshedpur</option><option>Jodhpur</option><option>Junagadh</option><option>Kakinada</option><option>Kanpur</option><option>Kochi</option><option>Kohima</option><option>Kolkata</option><option>Kota</option><option>Lucknow</option><option>Ludhiana</option><option>Madurai</option><option>Mangalore</option><option>Mumbai</option><option>Meerut</option><option>Moradabad</option><option>Mysore</option><option>Nagpur</option><option>Nainital</option><option>Nashik</option><option>Navi Mumbai</option><option>Nellore</option><option>New Delhi</option><option>Nizamabad</option><option>NOIDA</option><option>Patna</option><option>Pune</option><option>Raipur</option><option>Rajkot</option><option>Ranchi</option><option>Salem</option><option>Shillong</option><option>Shimla</option><option>Silchar</option><option>Siliguri</option><option>Srinagar</option><option>Surat</option><option>Thane</option><option>Thiruvananthapuram</option><option>Thrissur</option><option>Tiruchirappalli</option><option>Tirupathi</option><option>Udaipur</option><option>Varanasi</option><option>Vellore</option><option>Vijayawada</option><option>Visakhapatnam</option><option>Warangal</option>
                        </select>
                    </div>
                </div>

                <!-- Address -->
                <div class="space-y-2">
                    <label class="text-label-md text-on-surface-variant block">Full Address</label>
                    <textarea name="address" rows="3" placeholder="Enter your complete address..." class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all resize-none"></textarea>
                </div>

                <!-- Eligibility Check -->
                <div class="bg-surface-container-low rounded-lg p-4 md:p-6 border border-outline-variant">
                    <h4 class="text-label-md text-on-surface mb-4 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">verified_user</span>
                        Eligibility Criteria
                    </h4>
                    <div class="space-y-3 mb-4">
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk1" name="chk1" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk1" class="text-body-md text-on-surface-variant">My hemoglobin is not less than 12.5 grams</label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk2" name="chk2" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk2" class="text-body-md text-on-surface-variant">I am free from acute respiratory diseases and skin diseases</label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk3" name="chk3" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk3" class="text-body-md text-on-surface-variant">I do not carry any disease transmissible by blood transfusion</label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk4" name="chk4" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk4" class="text-body-md text-on-surface-variant">I am not under medication for Malaria / Tuberculosis / Diabetes / Fits / Convulsions</label>
                        </div>
                    </div>
                    <div class="space-y-3">
                        <h4 class="text-label-md text-on-surface mb-3">I have NOT suffered from:</h4>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk5" name="chk5" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk5" class="text-body-md text-on-surface-variant">Hepatitis B, C</label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk6" name="chk6" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk6" class="text-body-md text-on-surface-variant">AIDS</label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk7" name="chk7" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk7" class="text-body-md text-on-surface-variant">Cancer</label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk8" name="chk8" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk8" class="text-body-md text-on-surface-variant">Kidney disease</label>
                        </div>
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="chk9" name="chk9" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                            <label for="chk9" class="text-body-md text-on-surface-variant">Heart disease</label>
                        </div>
                    </div>
                    <div class="mt-4 flex items-start gap-3">
                        <input type="checkbox" id="chk10" name="activeStatus" value="true" class="check w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                        <label for="chk10" class="text-body-md text-on-surface font-semibold">I confirm that I have read and meet the above eligibility criteria.</label>
                    </div>
                </div>

                <!-- Terms & Submit -->
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <input type="checkbox" id="terms" name="terms" class="w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary">
                        <label for="terms" class="text-caption text-on-surface-variant">I agree to the <a href="#" class="text-primary hover:underline">Terms of Service</a> and <a href="#" class="text-primary hover:underline">Privacy Policy</a></label>
                    </div>
                    <button type="submit" class="w-full h-14 bg-primary text-white font-h3 text-body-md rounded-lg hover:opacity-90 active:scale-[0.99] transition-all duration-300 shadow-lg shadow-primary/20 flex items-center justify-center gap-3">
                        Register as Donor
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

<% include partials/footer %>

<script src="/js/scripts/register_script.js"></script>
