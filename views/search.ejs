<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="text-center mb-12">
        <h1 class="text-h1 text-on-surface mb-4">Find a Donor</h1>
        <p class="text-body-lg text-on-surface-variant max-w-2xl mx-auto">Search for blood donors in your area. Every second counts when someone needs blood.</p>
    </div>

    <!-- Search Card -->
    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-2xl p-6 md:p-8 border border-outline-variant">
        <form action="/search" method="post" class="space-y-6">
            <!-- Search Fields -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="space-y-2">
                    <label class="text-label-md text-on-surface-variant block">City</label>
                    <select name="city" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all appearance-none">
                        <option value="">Select City</option>
                        <option>Agartala</option><option>Agra</option><option>Ahmedabad</option><option>Ahmednagar</option><option>Aizwal</option><option>Ajmer</option><option>Akola</option><option>Aligarh</option><option>Allahabad</option><option>Alwar</option><option>Ambala</option><option>Amravati</option><option>Amreli</option><option>Amritsar</option><option>Anand</option><option>Anantapur</option><option>Anklesvar</option><option>Anuppur</option><option>Araria</option><option>Arcot</option><option>Arrah</option><option>Aruppukkottai</option><option>Asansol</option><option>Ashok Nagar</option><option>Aurangabad</option><option>Azamgarh</option><option>Bahadurgarh</option><option>Baharampur</option><option>Bahraich</option><option>Balaghat</option><option>Balasore</option><option>Balia</option><option>Ballabhgarh</option><option>Ballarpur</option><option>Balrampur</option><option>Banda</option><option>Bangalore</option><option>Banswara</option><option>Bardhaman</option><option>Bareilly</option><option>Barmer</option><option>Barrackpur</option><option>Barwani</option><option>Beawar</option><option>Belgaum</option><option>Bellary</option><option>Bengaluru</option><option>Betul</option><option>Bhagalpur</option><option>Bhandara</option><option>Bharatpur</option><option>Bharuch</option><option>Bhavnagar</option><option>Bhilai Nagar</option><option>Bhimavaram</option><option>Bhiwandi</option><option>Bhopal</option><option>Bhubaneswar</option><option>Bhuj</option><option>Bidar</option><option>Bihar Sharif</option><option>Bikaner</option><option>Bilaspur</option><option>Bokaro Steel City</option><option>Bongaigaon</option><option>Bulandshahr</option><option>Buldana</option><option>Burhanpur</option><option>Buxar</option><option>Chandigarh</option><option>Chennai</option><option>Coimbatore</option><option>Cuttack</option><option>Dehradun</option><option>Delhi</option><option>Dhanbad</option><option>Dharwad</option><option>Dhule</option><option>Dibrugarh</option><option>Dispur</option><option>Durgapur</option><option>Ernakulam</option><option>Erode</option><option>Faridabad</option><option>Gandhinagar</option><option>Gangtok</option><option>Gaya</option><option>Ghaziabad</option><option>Goa Velha</option><option>Gorakhpur</option><option>Greater Noida</option><option>Gurgaon</option><option>Guwahati</option><option>Gwalior</option><option>Haridwar</option><option>Hisar</option><option>Howrah</option><option>Hubli</option><option>Hyderabad</option><option>Indore</option><option>Jabalpur</option><option>Jaipur</option><option>Jalandhar</option><option>Jammu</option><option>Jamshedpur</option><option>Jodhpur</option><option>Junagadh</option><option>Kakinada</option><option>Kanpur</option><option>Kochi</option><option>Kohima</option><option>Kolkata</option><option>Kota</option><option>Lucknow</option><option>Ludhiana</option><option>Madurai</option><option>Mangalore</option><option>Mumbai</option><option>Meerut</option><option>Moradabad</option><option>Mysore</option><option>Nagpur</option><option>Nainital</option><option>Nashik</option><option>Navi Mumbai</option><option>Nellore</option><option>New Delhi</option><option>Nizamabad</option><option>NOIDA</option><option>Patna</option><option>Pune</option><option>Raipur</option><option>Rajkot</option><option>Ranchi</option><option>Salem</option><option>Shillong</option><option>Shimla</option><option>Silchar</option><option>Siliguri</option><option>Srinagar</option><option>Surat</option><option>Thane</option><option>Thiruvananthapuram</option><option>Thrissur</option><option>Tiruchirappalli</option><option>Tirupathi</option><option>Udaipur</option><option>Varanasi</option><option>Vellore</option><option>Vijayawada</option><option>Visakhapatnam</option><option>Warangal</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-label-md text-on-surface-variant block">Blood Group</label>
                    <select name="bloodGroup" class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all appearance-none">
                        <option value="0">Any</option>
                        <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                        <option>B+</option><option>B-</option><option>A1B+</option><option>A1B-</option>
                        <option>A2B+</option><option>A2B-</option><option>AB+</option><option>AB-</option>
                        <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-label-md text-on-surface-variant block">Urgency Level</label>
                    <select class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all appearance-none">
                        <option>All</option>
                        <option>Normal (Available)</option>
                        <option>Urgent (Within 24h)</option>
                        <option>Critical (ASAP)</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button type="submit" class="w-full h-12 bg-primary text-on-primary rounded-lg font-label-md hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">search</span>
                        Search Donors
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Info Section -->
    <div class="mt-12 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-primary text-2xl">speed</span>
            </div>
            <h3 class="text-label-md text-on-surface mb-2 font-semibold">Fast Matching</h3>
            <p class="text-caption text-on-surface-variant">Our system quickly finds compatible donors based on blood type and location.</p>
        </div>
        <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
            <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-secondary text-2xl">verified_user</span>
            </div>
            <h3 class="text-label-md text-on-surface mb-2 font-semibold">Verified Donors</h3>
            <p class="text-caption text-on-surface-variant">All donors are verified through our eligibility criteria to ensure safety.</p>
        </div>
        <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm">
            <div class="w-12 h-12 bg-tertiary/10 rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-tertiary text-2xl">support_agent</span>
            </div>
            <h3 class="text-label-md text-on-surface mb-2 font-semibold">24/7 Support</h3>
            <p class="text-caption text-on-surface-variant">Need help? Our team is available around the clock to assist you.</p>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="mt-12 text-center">
        <p class="text-body-md text-on-surface-variant mb-4">Can't find what you're looking for?</p>
        <a href="/auth/register" class="inline-flex items-center px-6 py-3 bg-secondary text-on-secondary rounded-lg font-label-md hover:bg-on-secondary-container transition-colors shadow-md shadow-secondary/20 gap-2">
            <span class="material-symbols-outlined">add_circle</span>
            Register as a Donor
        </a>
    </div>
</main>

<% include partials/footer %>
