<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-secondary text-4xl">edit</span>
            </div>
            <h1 class="text-h1 text-on-surface mb-3">Edit Hospital Profile</h1>
            <p class="text-body-md text-on-surface-variant">Update your hospital information to better serve your community.</p>
        </div>

        <!-- Edit Form -->
        <div class="bg-white rounded-2xl shadow-lg border border-outline-variant overflow-hidden">
            <form action="/editHospital" id="_form" class="space-y-8" method="POST" enctype="multipart/form-data">
                <div class="p-6 md:p-10 space-y-6">
                    <!-- Basic Info -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary">business</span>
                            Hospital Information
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Hospital Name</label>
                                <input type="text" name="name" value="<%= hospital.name %>" disabled class="w-full h-12 px-4 bg-surface-container-low/50 border-none rounded-lg text-body-md opacity-60 cursor-not-allowed">
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Username</label>
                                <input type="text" name="username" value="<%= hospital.local.username %>" disabled class="w-full h-12 px-4 bg-surface-container-low/50 border-none rounded-lg text-body-md opacity-60 cursor-not-allowed">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Email Address</label>
                                <input type="email" name="email" value="<%= hospital.email %>" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Contact Number</label>
                                <input type="tel" id="_phoneNumber" name="contactNumber" value="<%= hospital.contactNumber %>" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary">lock</span>
                            Password
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Password</label>
                                <input type="password" id="_password" name="password" placeholder="Enter password to save changes" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Confirm Password</label>
                                <input type="password" id="_confirmPassword" placeholder="Confirm your password" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-tertiary">location_on</span>
                            Location
                        </h3>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">City</label>
                            <select name="city" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                <option value="">Select City</option>
                                <option <%= hospital.city === 'Agartala' ? 'selected' : '' %>>Agartala</option>
                                <option <%= hospital.city === 'Agra' ? 'selected' : '' %>>Agra</option>
                                <option <%= hospital.city === 'Ahmedabad' ? 'selected' : '' %>>Ahmedabad</option>
                                <option <%= hospital.city === 'Bengaluru' ? 'selected' : '' %>>Bengaluru</option>
                                <option <%= hospital.city === 'Chennai' ? 'selected' : '' %>>Chennai</option>
                                <option <%= hospital.city === 'Delhi' ? 'selected' : '' %>>Delhi</option>
                                <option <%= hospital.city === 'Hyderabad' ? 'selected' : '' %>>Hyderabad</option>
                                <option <%= hospital.city === 'Kolkata' ? 'selected' : '' %>>Kolkata</option>
                                <option <%= hospital.city === 'Mumbai' ? 'selected' : '' %>>Mumbai</option>
                                <option <%= hospital.city === 'Pune' ? 'selected' : '' %>>Pune</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Address</label>
                            <textarea name="address" rows="3" required class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all resize-none"><%= hospital.address %></textarea>
                        </div>
                    </div>

                    <!-- Profile Picture -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary">add_a_photo</span>
                            Hospital Logo
                        </h3>
                        <div class="flex items-center gap-4">
                            <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-outline-variant bg-surface-container-low">
                                <% if(hospital.profilePic) { %>
                                    <% var file = 'uploads/' + hospital.profilePic; %>
                                    <img src="<%= file %>" alt="Current logo" class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center">
                                        <span class="material-symbols-outlined text-3xl text-outline-variant">local_hospital</span>
                                    </div>
                                <% } %>
                            </div>
                            <div class="flex-1">
                                <input type="file" name="profilePic" accept="image/*" class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                <%= typeof msg != 'undefined' ? '<p class="text-caption text-error mt-1">' + msg + '</p>' : '' %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="px-6 md:px-10 pb-10">
                    <div class="flex flex-wrap gap-4">
                        <button type="submit" class="flex-1 min-w-[200px] h-14 bg-secondary text-on-secondary rounded-lg font-label-md hover:bg-on-secondary-container active:scale-[0.99] transition-all duration-300 shadow-lg shadow-secondary/20 flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">save</span>
                            Save Changes
                        </button>
                        <a href="/profileHospital" class="inline-flex items-center px-8 py-4 bg-surface-container-low text-on-surface rounded-lg font-label-md hover:bg-surface-container transition-colors gap-2">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</main>

<% include partials/footer %>
