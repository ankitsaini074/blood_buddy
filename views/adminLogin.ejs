<!DOCTYPE html>
<html lang="en">
<head>
    <title>Admin Login – Blood Buddy</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'primary': '#af101a',
                        'on-primary': '#ffffff',
                        'surface-container-low': '#f3f3f6',
                        'on-surface': '#1a1c1e',
                        'on-surface-variant': '#5b403d',
                        'outline-variant': '#e4beba',
                        'error': '#ba1a1a',
                    },
                    fontFamily: { sans: ['Public Sans', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Public Sans', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <a href="/" class="text-2xl font-bold text-primary">Blood Buddy</a>
            <p class="text-sm text-on-surface-variant mt-1">Admin Panel</p>
        </div>
        <div class="bg-white rounded-2xl shadow-lg p-8">
            <div class="flex flex-col items-center mb-6">
                <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-primary text-2xl">admin_panel_settings</span>
                </div>
                <h1 class="text-xl font-semibold text-on-surface">Admin Login</h1>
                <p class="text-sm text-on-surface-variant mt-1">Enter your admin password to continue</p>
            </div>

            <% if (error && error.length > 0) { %>
                <div class="flex items-center gap-2 bg-red-50 border border-red-200 text-error rounded-lg px-4 py-3 mb-4 text-sm">
                    <span class="material-symbols-outlined text-base">error</span>
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1">Admin Password</label>
                    <input
                        type="password"
                        name="password"
                        required
                        autofocus
                        placeholder="Enter admin password"
                        class="w-full h-11 px-4 bg-surface-container-low rounded-lg text-sm border-none focus:outline-none focus:ring-2 focus:ring-primary/30 transition"
                    >
                </div>
                <button type="submit" class="w-full h-11 bg-primary text-white rounded-lg text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition-all shadow-md shadow-primary/20">
                    Sign In
                </button>
            </form>
        </div>
        <p class="text-center text-xs text-on-surface-variant mt-6">
            <a href="/" class="hover:text-primary transition-colors">← Back to site</a>
        </p>
    </div>
</body>
</html>
