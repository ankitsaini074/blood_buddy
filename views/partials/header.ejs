                </div>
                <button type="submit" class="w-full h-12 bg-primary text-white rounded-lg font-label-md hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">search</span>
                    Search Donors
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Register Choice Modal -->
<div id="register-choice" class="fixed inset-0 z-[100] hidden">
    <div class="modal-overlay absolute inset-0 bg-black/50" onclick="closeModal('register-choice')"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="modal-content-panel bg-white rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.15)] w-full max-w-md p-8 relative z-10">
            <button onclick="closeModal('register-choice')" class="absolute top-4 right-4 p-1 rounded-full hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-primary text-3xl">how_to_reg</span>
                </div>
                <h2 class="text-h3 text-on-surface mb-1">Choose Account Type</h2>
                <p class="text-body-md text-on-surface-variant">Select how you want to register</p>
            </div>
            <div class="space-y-4">
                <a href="/auth/register" class="flex items-center gap-4 p-4 bg-surface-container-low rounded-lg hover:bg-surface-container transition-all cursor-pointer border border-outline-variant">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-primary">person</span>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-label-md text-on-surface font-semibold">Register as Donor</h3>
                        <p class="text-caption text-on-surface-variant">Save lives by donating blood</p>
                    </div>
                    <span class="material-symbols-outlined text-on-surface-variant">arrow_forward</span>
                </a>
                <a href="/auth/registerHospital" class="flex items-center gap-4 p-4 bg-surface-container-low rounded-lg hover:bg-surface-container transition-all cursor-pointer border border-outline-variant">
                    <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-secondary">local_hospital</span>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-label-md text-on-surface font-semibold">Register as Hospital</h3>
                        <p class="text-caption text-on-surface-variant">Manage blood inventory & find donors</p>
                    </div>
                    <span class="material-symbols-outlined text-on-surface-variant">arrow_forward</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Post Request Modal -->
<div id="post-request" class="fixed inset-0 z-[100] hidden">
    <div class="modal-overlay absolute inset-0 bg-black/50" onclick="closeModal('post-request')"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="modal-content-panel bg-white rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.15)] w-full max-w-lg p-8 relative z-10 max-h-[90vh] overflow-y-auto">
            <button onclick="closeModal('post-request')" class="absolute top-4 right-4 p-1 rounded-full hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
            <div class="text-center mb-6">
                <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-primary text-2xl">emergency</span>
                </div>
                <h2 class="text-h3 text-on-surface">Post a Blood Request</h2>
                <p class="text-body-md text-on-surface-variant mt-1">Help will reach you faster</p>
            </div>
            <form action="/requests/new" method="POST" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Your Name <span class="text-primary">*</span></label>
                        <input type="text" name="requesterName" required placeholder="Full name"
                            class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                    </div>
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Contact Number <span class="text-primary">*</span></label>
                        <input type="tel" name="contactNumber" required placeholder="Phone number"
                            class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Blood Group Needed <span class="text-primary">*</span></label>
                        <select name="bloodGroup" required class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                            <option value="">Select group</option>
                            <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                            <option>A+</option><option>A-</option><option>B+</option><option>B-</option>
                            <option>A1B+</option><option>A1B-</option><option>A2B+</option><option>A2B-</option>
                            <option>AB+</option><option>AB-</option><option>O+</option><option>O-</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Urgency <span class="text-primary">*</span></label>
                        <select name="urgency" class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                            <option value="normal">Normal</option>
                            <option value="urgent">Urgent (Within 24h)</option>
                            <option value="critical">Critical (ASAP)</option>
                        </select>
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="text-label-md text-on-surface-variant block">City <span class="text-primary">*</span></label>
                    <input type="text" name="city" required placeholder="Your city"
                        class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                </div>
                <div class="space-y-1">
                    <label class="text-label-md text-on-surface-variant block">Hospital (optional)</label>
                    <input type="text" name="hospital" placeholder="Name of hospital"
                        class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                </div>
                <div class="space-y-1">
                    <label class="text-label-md text-on-surface-variant block">Message (optional)</label>
                    <textarea name="message" rows="2" placeholder="Any additional details..."
                        class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all resize-none"></textarea>
                </div>
                <button type="submit"
                    class="w-full h-12 bg-primary text-on-primary rounded-lg font-label-md hover:opacity-90 active:scale-[0.98] transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">send</span>
                    Submit Request
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed top-20 right-6 z-[200] flex flex-col gap-3 pointer-events-none"></div>

<script>
function showToast(message, type = 'error') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    const isSuccess = type === 'success';
    const bgColor = isSuccess ? 'bg-secondary' : 'bg-error';
    const textColor = isSuccess ? 'text-on-secondary' : 'text-on-error';
    const icon = isSuccess ? 'check_circle' : 'error';

    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg transform transition-all duration-300 translate-x-full opacity-0 ${bgColor} ${textColor}`;
    toast.innerHTML = `
        <span class="material-symbols-outlined">${icon}</span>
        <span class="text-body-md">${message}</span>
        <button class="ml-auto hover:opacity-70">
            <span class="material-symbols-outlined">close</span>
        </button>
    `;

    container.appendChild(toast);

    requestAnimationFrame(() => {
        toast.classList.remove('translate-x-full', 'opacity-0');
    });

    const closeBtn = toast.querySelector('button');
    closeBtn.onclick = () => {
        hideToast(toast);
    };

    setTimeout(() => {
        hideToast(toast);
    }, 4000);
}

function hideToast(toast) {
    toast.classList.add('translate-x-full', 'opacity-0');
    setTimeout(() => {
        if (toast.parentNode) {
            toast.parentNode.removeChild(toast);
        }
    }, 300);
}

function openModal(id) {
    const modal = document.getElementById(id);
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}
function closeModal(id) {
    const modal = document.getElementById(id);
    modal.classList.add('hidden');
    document.body.style.overflow = 'unset';
}
function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
}
// Close modals with Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.fixed.inset-0').forEach(function(modal) {
            modal.classList.add('hidden');
        });
        document.body.style.overflow = 'unset';
    }
});

// Flash Message Toasts
<% if(error && error.length > 0) { %>
showToast('<%= error %>', 'error');
<% } %>

<% if(success && success.length > 0) { %>
showToast('<%= success %>', 'success');
<% } %>
</script>
