<!DOCTYPE html>
<html lang="en">
<head>
    <title>Blood Buddy - Share a little, care a little</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/img/favicon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'surface-container': '#eeeef0',
                        'on-secondary-fixed': '#002020',
                        'inverse-on-surface': '#f0f0f3',
                        'background': '#f9f9fc',
                        'surface-container-low': '#f3f3f6',
                        'on-primary-fixed-variant': '#930010',
                        'on-surface': '#1a1c1e',
                        'on-primary-fixed': '#410003',
                        'secondary': '#006a6a',
                        'outline': '#8f6f6c',
                        'on-primary': '#ffffff',
                        'primary-fixed': '#ffdad6',
                        'surface-container-lowest': '#ffffff',
                        'on-secondary': '#ffffff',
                        'on-tertiary-fixed': '#001f2a',
                        'on-background': '#1a1c1e',
                        'outline-variant': '#e4beba',
                        'tertiary': '#005f7b',
                        'tertiary-container': '#00799c',
                        'inverse-surface': '#2f3133',
                        'on-secondary-container': '#006e6e',
                        'primary-container': '#d32f2f',
                        'inverse-primary': '#ffb3ac',
                        'on-tertiary': '#ffffff',
                        'primary': '#af101a',
                        'surface-dim': '#dadadc',
                        'secondary-fixed': '#93f2f2',
                        'surface-tint': '#ba1a20',
                        'on-surface-variant': '#5b403d',
                        'on-secondary-fixed-variant': '#004f4f',
                        'surface-container-highest': '#e2e2e5',
                        'surface-container-high': '#e8e8ea',
                        'on-error-container': '#93000a',
                        'secondary-container': '#90efef',
                        'error': '#ba1a1a',
                        'error-container': '#ffdad6',
                        'tertiary-fixed-dim': '#7bd1f8',
                        'tertiary-fixed': '#bee9ff',
                        'on-primary-container': '#fff2f0',
                        'primary-fixed-dim': '#ffb3ac',
                        'on-tertiary-fixed-variant': '#004d65',
                        'surface-bright': '#f9f9fc',
                        'on-tertiary-container': '#e9f7ff',
                        'secondary-fixed-dim': '#76d6d5',
                        'surface-variant': '#e2e2e5'
                    },
                    fontFamily: {
                        sans: ['Public Sans', 'sans-serif']
                    },
                    fontSize: {
                        'h1': ['40px', { lineHeight: '1.2', letterSpacing: '-0.02em', fontWeight: '700' }],
                        'body-md': ['16px', { lineHeight: '1.5', fontWeight: '400' }],
                        'body-lg': ['18px', { lineHeight: '1.6', fontWeight: '400' }],
                        'label-md': ['14px', { lineHeight: '1.4', letterSpacing: '0.05em', fontWeight: '600' }],
                        'h3': ['24px', { lineHeight: '1.3', fontWeight: '600' }],
                        'caption': ['12px', { lineHeight: '1.4', fontWeight: '400' }],
                        'h2': ['32px', { lineHeight: '1.25', letterSpacing: '-0.01em', fontWeight: '600' }]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Public Sans', sans-serif; background-color: #f9f9fc; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .material-symbols-outlined.filled {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .form-input-focus:focus {
            outline: none;
            border-color: #006a6a;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(0, 106, 106, 0.05);
        }
        .modal-overlay {
            transition: opacity 0.3s ease;
        }
        .modal-content-panel {
            transition: transform 0.3s ease, opacity 0.3s ease;
        }
    </style>
</head>
<body class="antialiased">

<nav class="bg-white border-b border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.04)] sticky top-0 z-50">
    <div class="flex items-center justify-between px-4 md:px-8 py-3 max-w-[1280px] mx-auto w-full">
        <div class="flex items-center gap-5">
            <a href="/tempHome" class="text-xl font-bold tracking-tight text-primary whitespace-nowrap">Blood Buddy</a>
            <div class="hidden lg:flex items-center gap-4">
                <a href="/tempHome" class="text-sm text-on-surface font-medium hover:text-primary transition-colors duration-300 whitespace-nowrap">Home</a>
                <a href="#" onclick="openModal('search-donors'); return false;" class="text-sm text-on-surface font-medium hover:text-primary transition-colors duration-300 whitespace-nowrap">Search Donor</a>
                <a href="/requests" class="text-sm text-on-surface font-medium hover:text-primary transition-colors duration-300 whitespace-nowrap">Blood Requests</a>
                <a href="/camps" class="text-sm text-on-surface font-medium hover:text-primary transition-colors duration-300 whitespace-nowrap">Camps</a>
                <a href="/hospital-needs" class="text-sm text-on-surface font-medium hover:text-primary transition-colors duration-300 whitespace-nowrap">Hospital Needs</a>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <% if(!currentUser){ %>
                <button onclick="openModal('login-user')" class="text-sm text-on-surface font-medium hover:text-primary transition-colors duration-300 whitespace-nowrap hidden lg:block">User Login</button>
                <button onclick="openModal('login-hospital')" class="text-sm text-on-surface font-medium hover:text-primary transition-colors duration-300 whitespace-nowrap hidden lg:block">Hospital Login</button>
                <a href="/requests" onclick="openModal('post-request'); return false;" class="px-3 py-2 border border-primary text-primary rounded-lg text-sm font-medium hover:bg-primary/5 active:scale-95 transition-all duration-300 hidden lg:inline-flex items-center gap-1 whitespace-nowrap">
                    <span class="material-symbols-outlined text-sm">emergency</span>Need Blood
                </a>
                <button onclick="openModal('register-choice')" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:opacity-90 active:scale-95 transition-all duration-300 shadow-md shadow-primary/20 whitespace-nowrap">Register</button>
            <% } else { %>
                <a href="<%= currentUser.userType === 'Donor' ? '/profile' : '/profileHospital' %>" class="flex items-center gap-2 text-on-surface font-medium hover:text-primary transition-colors duration-300">
                    <span class="material-symbols-outlined text-xl">account_circle</span>
                    <span class="hidden md:inline"><%= currentUser.local.username %></span>
                </a>
                <a href="/auth/logout" class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-300">Logout</a>
            <% } %>
            <!-- Mobile menu button -->
            <!-- Mobile menu button -->
            <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-lg hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 px-6 py-4 space-y-3">
        <a href="/tempHome" class="block text-on-surface font-medium hover:text-primary transition-colors py-2">Home</a>
        <a href="#" onclick="openModal('search-donors'); return false;" class="block text-on-surface font-medium hover:text-primary transition-colors py-2">Search Donor</a>
        <a href="/requests" class="block text-on-surface font-medium hover:text-primary transition-colors py-2">Blood Requests</a>
        <a href="/camps" class="block text-on-surface font-medium hover:text-primary transition-colors py-2">Camps</a>
        <a href="/hospital-needs" class="block text-on-surface font-medium hover:text-primary transition-colors py-2">Hospital Needs</a>
        <% if(!currentUser){ %>
            <button onclick="openModal('register-choice')" class="w-full bg-primary text-white text-center rounded-lg font-medium py-3 hover:opacity-90 transition-all">Register</button>
        <% } %>
    </div>
</nav>

<!-- User Login Modal -->
<div id="login-user" class="fixed inset-0 z-[100] hidden">
    <div class="modal-overlay absolute inset-0 bg-black/50" onclick="closeModal('login-user')"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="modal-content-panel bg-white rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.15)] w-full max-w-md p-8 relative z-10">
            <button onclick="closeModal('login-user')" class="absolute top-4 right-4 p-1 rounded-full hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-primary text-3xl">person</span>
                </div>
                <h2 class="text-h3 text-on-surface mb-1">User Login</h2>
                <p class="text-body-md text-on-surface-variant">Sign in to your donor account</p>
            </div>
            <form action="/auth/login" method="post" class="space-y-4">
                <div class="space-y-2">
                    <label for="login-username" class="text-label-md text-on-surface-variant block">Username</label>
                    <input id="login-username" type="text" name="username" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all" placeholder="Enter your username">
                </div>
                <div class="space-y-2">
                    <label for="login-password" class="text-label-md text-on-surface-variant block">Password</label>
                    <input id="login-password" type="password" name="password" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all" placeholder="Enter your password">
                </div>
                <button type="submit" class="w-full h-12 bg-primary text-white rounded-lg font-label-md hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-lg shadow-primary/20">Login</button>
            </form>
            <p class="text-center text-caption text-on-surface-variant mt-6">Don't have an account? <a href="#" onclick="openModal('register-choice'); return false;" class="text-secondary hover:underline font-medium">Register</a></p>
        </div>
    </div>
</div>

<!-- Hospital Login Modal -->
<div id="login-hospital" class="fixed inset-0 z-[100] hidden">
    <div class="modal-overlay absolute inset-0 bg-black/50" onclick="closeModal('login-hospital')"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="modal-content-panel bg-white rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.15)] w-full max-w-md p-8 relative z-10">
            <button onclick="closeModal('login-hospital')" class="absolute top-4 right-4 p-1 rounded-full hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-secondary text-3xl">local_hospital</span>
                </div>
                <h2 class="text-h3 text-on-surface mb-1">Hospital Login</h2>
                <p class="text-body-md text-on-surface-variant">Sign in to your hospital account</p>
            </div>
            <form action="/auth/loginHospital" method="post" class="space-y-4">
                <div class="space-y-2">
                    <label for="hosp-username" class="text-label-md text-on-surface-variant block">Username</label>
                    <input id="hosp-username" type="text" name="username" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all" placeholder="Enter your username">
                </div>
                <div class="space-y-2">
                    <label for="hosp-password" class="text-label-md text-on-surface-variant block">Password</label>
                    <input id="hosp-password" type="password" name="password" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all" placeholder="Enter your password">
                </div>
                <button type="submit" class="w-full h-12 bg-secondary text-on-secondary rounded-lg font-label-md hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-lg shadow-secondary/20">Login</button>
            </form>
            <p class="text-center text-caption text-on-surface-variant mt-6">Don't have an account? <a href="#" onclick="openModal('register-choice'); return false;" class="text-secondary hover:underline font-medium">Register</a></p>
        </div>
    </div>
</div>

<!-- Search Donors Modal -->
<div id="search-donors" class="fixed inset-0 z-[100] hidden">
    <div class="modal-overlay absolute inset-0 bg-black/50" onclick="closeModal('search-donors')"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="modal-content-panel bg-white rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.15)] w-full max-w-lg p-8 relative z-10">
            <button onclick="closeModal('search-donors')" class="absolute top-4 right-4 p-1 rounded-full hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-primary text-3xl">bloodtype</span>
                </div>
                <h2 class="text-h3 text-on-surface mb-1">Find a Donor</h2>
                <p class="text-body-md text-on-surface-variant">Search for blood donors near you</p>
            </div>
            <form action="/search" method="post" class="space-y-4">
                <div class="space-y-2">
                    <label for="modal-city" class="text-label-md text-on-surface-variant block">City</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-3.5 text-on-surface-variant">location_on</span>
                        <select id="modal-city" name="city" required class="w-full h-12 pl-10 pr-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all appearance-none">
                            <option value="0">Select City</option>
                            <option>Agartala</option><option>Agra</option><option>Ahmedabad</option><option>Ahmednagar</option><option>Aizwal</option><option>Ajmer</option><option>Akola</option><option>Aligarh</option><option>Allahabad</option><option>Alwar</option><option>Ambala</option><option>Amravati</option><option>Amreli</option><option>Amritsar</option><option>Anand</option><option>Anantapur</option><option>Anklesvar</option><option>Anuppur</option><option>Araria</option><option>Arcot</option><option>Arrah</option><option>Aruppukkottai</option><option>Asansol</option><option>Ashok Nagar</option><option>Aurangabad</option><option>Azamgarh</option><option>Bahadurgarh</option><option>Baharampur</option><option>Bahraich</option><option>Balaghat</option><option>Balasore</option><option>Balia</option><option>Ballabhgarh</option><option>Ballarpur</option><option>Balrampur</option><option>Banda</option><option>Bangalore</option><option>Banswara</option><option>Bardhaman</option><option>Bareilly</option><option>Barmer</option><option>Barrackpur</option><option>Barwani</option><option>Beawar</option><option>Belgaum</option><option>Bellary</option><option>Bengaluru</option><option>Betul</option><option>Bhagalpur</option><option>Bhandara</option><option>Bharatpur</option><option>Bharuch</option><option>Bhavnagar</option><option>Bhilai Nagar</option><option>Bhimavaram</option><option>Bhiwandi</option><option>Bhopal</option><option>Bhubaneswar</option><option>Bhuj</option><option>Bidar</option><option>Bihar Sharif</option><option>Bikaner</option><option>Bilaspur</option><option>Bokaro Steel City</option><option>Bongaigaon</option><option>Bulandshahr</option><option>Buldana</option><option>Burhanpur</option><option>Buxar</option><option>Chandigarh</option><option>Chennai</option><option>Coimbatore</option><option>Cuttack</option><option>Dehradun</option><option>Delhi</option><option>Dhanbad</option><option>Dharwad</option><option>Dhule</option><option>Dibrugarh</option><option>Dispur</option><option>Durgapur</option><option>Ernakulam</option><option>Erode</option><option>Faridabad</option><option>Gandhinagar</option><option>Gangtok</option><option>Gaya</option><option>Ghaziabad</option><option>Goa Velha</option><option>Gorakhpur</option><option>Greater Noida</option><option>Gurgaon</option><option>Guwahati</option><option>Gwalior</option><option>Haridwar</option><option>Hisar</option><option>Howrah</option><option>Hubli</option><option>Hyderabad</option><option>Indore</option><option>Jabalpur</option><option>Jaipur</option><option>Jalandhar</option><option>Jammu</option><option>Jamshedpur</option><option>Jodhpur</option><option>Junagadh</option><option>Kakinada</option><option>Kanpur</option><option>Kochi</option><option>Kohima</option><option>Kolkata</option><option>Kota</option><option>Lucknow</option><option>Ludhiana</option><option>Madurai</option><option>Mangalore</option><option>Mumbai</option><option>Meerut</option><option>Moradabad</option><option>Mysore</option><option>Nagpur</option><option>Nainital</option><option>Nashik</option><option>Navi Mumbai</option><option>Nellore</option><option>New Delhi</option><option>Nizamabad</option><option>NOIDA</option><option>Patna</option><option>Pune</option><option>Raipur</option><option>Rajkot</option><option>Ranchi</option><option>Salem</option><option>Shillong</option><option>Shimla</option><option>Silchar</option><option>Siliguri</option><option>Srinagar</option><option>Surat</option><option>Thane</option><option>Thiruvananthapuram</option><option>Thrissur</option><option>Tiruchirappalli</option><option>Tirupathi</option><option>Udaipur</option><option>Varanasi</option><option>Vellore</option><option>Vijayawada</option><option>Visakhapatnam</option><option>Warangal</option>
                        </select>
                    </div>
                </div>
                <div class="space-y-2">
                    <label for="modal-blood" class="text-label-md text-on-surface-variant block">Blood Group</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-3.5 text-on-surface-variant">water_drop</span>
                        <select id="modal-blood" name="bloodGroup" class="w-full h-12 pl-10 pr-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all appearance-none">
                            <option value="0">Any</option>
                            <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                            <option>B+</option><option>B-</option><option>A1B+</option><option>A1B-</option>
                            <option>A2B+</option><option>A2B-</option><option>AB+</option><option>AB-</option>
                            <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
