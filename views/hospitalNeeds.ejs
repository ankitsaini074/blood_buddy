<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
        <div>
            <h1 class="text-h1 text-on-surface mb-2">Hospital Blood Needs</h1>
            <p class="text-body-lg text-on-surface-variant">Bulk requests from registered hospitals — help by donating or spreading the word</p>
        </div>
        <% if (currentUser && currentUser.userType === 'Hospital') { %>
        <button onclick="document.getElementById('postNeedModal').classList.remove('hidden')"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-on-primary rounded-xl font-semibold shadow-lg shadow-primary/20 hover:opacity-90 transition-all">
            <span class="material-symbols-outlined">add_circle</span>
            Post a Need
        </button>
        <% } %>
    </div>

    <!-- Stats -->
    <%
        const criticalNeeds = needs.filter(n => n.urgency === 'critical');
        const urgentNeeds   = needs.filter(n => n.urgency === 'urgent');
    %>
    <div class="flex gap-3 mb-8 flex-wrap">
        <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary/10 text-primary rounded-xl text-sm font-semibold border border-primary/20">
            <span class="material-symbols-outlined text-base">emergency</span>
            <%= criticalNeeds.length %> critical
        </span>
        <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-amber-50 text-amber-700 rounded-xl text-sm font-semibold border border-amber-200">
            <span class="material-symbols-outlined text-base">priority_high</span>
            <%= urgentNeeds.length %> urgent
        </span>
        <span class="inline-flex items-center gap-1.5 px-4 py-2 bg-surface-container-low text-on-surface-variant rounded-xl text-sm font-semibold border border-outline-variant">
            <%= needs.length %> open total
        </span>
    </div>

    <!-- Needs Grid -->
    <% if (needs.length === 0) { %>
    <div class="bg-white border border-outline-variant rounded-2xl p-16 text-center">
        <span class="material-symbols-outlined text-5xl text-on-surface-variant opacity-30 block mb-3">bloodtype</span>
        <p class="text-on-surface-variant text-base">No open hospital blood needs right now</p>
    </div>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% needs.forEach(function(need) {
            const urgencyStyles = {
                critical: { border: 'border-primary/30', bg: 'bg-primary/5', badge: 'bg-primary/10 text-primary', strip: 'from-primary to-primary-container', dot: true },
                urgent:   { border: 'border-amber-200',  bg: 'bg-amber-50/50', badge: 'bg-amber-50 text-amber-700', strip: 'from-amber-400 to-amber-200', dot: false },
                normal:   { border: 'border-outline-variant', bg: '', badge: 'bg-blue-50 text-blue-600', strip: 'from-secondary to-tertiary', dot: false }
            }[need.urgency] || {};
        %>
        <div class="bg-white border <%= urgencyStyles.border %> rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col <%= urgencyStyles.bg %>">
            <div class="h-1.5 bg-gradient-to-r <%= urgencyStyles.strip %>"></div>
            <div class="p-6 flex flex-col flex-1">
                <!-- Blood group + urgency -->
                <div class="flex items-start justify-between mb-4">
                    <div class="flex flex-col items-center bg-primary/10 text-primary rounded-xl px-4 py-2 min-w-[64px] text-center">
                        <span class="text-xs font-semibold uppercase tracking-wide text-on-surface-variant">Blood</span>
                        <span class="text-2xl font-extrabold leading-tight"><%= need.bloodGroup %></span>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold capitalize <%= urgencyStyles.badge %>">
                        <% if (urgencyStyles.dot) { %><span class="w-1.5 h-1.5 bg-primary rounded-full inline-block animate-pulse"></span><% } %>
                        <%= need.urgency %>
                    </span>
                </div>

                <h3 class="text-base font-bold text-on-surface mb-0.5"><%= need.hospitalName %></h3>
                <p class="text-sm text-on-surface-variant mb-3"><%= need.city %></p>

                <div class="flex items-center gap-2 mb-3">
                    <span class="material-symbols-outlined text-base text-secondary">water_drop</span>
                    <span class="text-sm font-semibold text-on-surface"><%= need.unitsNeeded %> unit<%= need.unitsNeeded !== 1 ? 's' : '' %> needed</span>
                </div>

                <% if (need.deadline) { %>
                <div class="flex items-center gap-2 mb-3">
                    <span class="material-symbols-outlined text-base text-secondary">schedule</span>
                    <span class="text-sm text-on-surface-variant">Needed by <%= new Date(need.deadline).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span>
                </div>
                <% } %>

                <% if (need.notes) { %>
                <p class="text-sm text-on-surface-variant italic mb-4 line-clamp-2"><%= need.notes %></p>
                <% } %>

                <div class="mt-auto pt-4 border-t border-outline-variant/40 flex items-center justify-between">
                    <span class="text-xs text-on-surface-variant"><%= new Date(need.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) %></span>
                    <% if (need.contactNumber) { %>
                    <a href="tel:<%= need.contactNumber %>"
                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-secondary text-on-secondary rounded-lg text-sm font-semibold hover:opacity-90 transition-all shadow-sm">
                        <span class="material-symbols-outlined text-sm">call</span>
                        Contact
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>
</main>

<!-- Post Bulk Need Modal (hospitals only) -->
<% if (currentUser && currentUser.userType === 'Hospital') { %>
<div id="postNeedModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-8 relative">
        <button onclick="document.getElementById('postNeedModal').classList.add('hidden')"
            class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">bloodtype</span>
            </div>
            <h2 class="text-h2 text-on-surface">Post Bulk Blood Need</h2>
        </div>
        <form action="/hospital-needs/new" method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Blood Group *</label>
                    <select name="bloodGroup" required
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="">Select</option>
                        <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                        <option>B+</option><option>B-</option><option>A1B+</option><option>A1B-</option>
                        <option>A2B+</option><option>A2B-</option><option>AB+</option><option>AB-</option>
                        <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Units Needed *</label>
                    <input type="number" name="unitsNeeded" min="1" required placeholder="e.g. 5"
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Urgency *</label>
                    <select name="urgency" required
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="normal">Normal</option>
                        <option value="urgent">Urgent</option>
                        <option value="critical">Critical</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Needed By (optional)</label>
                    <input type="date" name="deadline"
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
                </div>
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Contact Number</label>
                <input type="tel" name="contactNumber" value="<%= currentUser.contactNumber || '' %>"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Notes (optional)</label>
                <textarea name="notes" rows="2" placeholder="Reason for need, special blood type requirements, etc."
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-primary text-on-primary rounded-xl font-semibold hover:opacity-90 transition-all mt-2">
                Post Blood Need
            </button>
        </form>
    </div>
</div>
<% } %>

<% include partials/footer %>
