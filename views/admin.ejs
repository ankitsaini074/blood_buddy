<!DOCTYPE html>
<html lang="en">
<head>
    <title>Admin Dashboard – Blood Buddy</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'primary': '#af101a',
                        'on-primary': '#ffffff',
                        'secondary': '#006a6a',
                        'on-secondary': '#ffffff',
                        'tertiary': '#005f7b',
                        'surface-container-low': '#f3f3f6',
                        'surface-container': '#eeeef0',
                        'on-surface': '#1a1c1e',
                        'on-surface-variant': '#5b403d',
                        'outline-variant': '#e4beba',
                        'inverse-surface': '#2f3133',
                        'inverse-on-surface': '#f0f0f3',
                        'error': '#ba1a1a',
                    },
                    fontFamily: { sans: ['Public Sans', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Public Sans', sans-serif; background-color: #f9f9fc; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .material-symbols-outlined.filled { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .tab-btn.active { background-color: #af101a; color: #fff; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        #search-donors-input:focus, #search-hospitals-input:focus { outline: none; }
    </style>
</head>
<body class="antialiased min-h-screen">

<!-- Navbar -->
<nav class="bg-inverse-surface text-inverse-on-surface sticky top-0 z-50 shadow-lg">
    <div class="max-w-[1400px] mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-white text-lg filled">admin_panel_settings</span>
                </div>
                <div>
                    <span class="font-bold text-lg">Blood Buddy</span>
                    <span class="text-xs text-inverse-on-surface/60 ml-2">Admin Panel</span>
                </div>
            </div>
            <div class="hidden md:flex items-center gap-1">
                <a href="/admin" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm bg-white/15 text-inverse-on-surface font-medium transition-colors">
                    <span class="material-symbols-outlined text-base">dashboard</span> Dashboard
                </a>
                <a href="/admin/inventory" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm text-inverse-on-surface/70 hover:bg-white/10 hover:text-inverse-on-surface transition-colors">
                    <span class="material-symbols-outlined text-base">water_drop</span> Inventory
                </a>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <a href="/" target="_blank" class="flex items-center gap-1.5 text-sm text-inverse-on-surface/70 hover:text-inverse-on-surface transition-colors">
                <span class="material-symbols-outlined text-base">open_in_new</span>
                <span class="hidden md:inline">View Site</span>
            </a>
            <form action="/admin/logout" method="POST">
                <button type="submit" class="flex items-center gap-1.5 text-sm bg-white/10 hover:bg-white/20 px-4 py-2 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-base">logout</span>
                    Logout
                </button>
            </form>
        </div>
    </div>
</nav>

<div class="max-w-[1400px] mx-auto px-6 py-8">

    <!-- Flash messages -->
    <% if (success && success.length > 0) { %>
        <div class="flex items-center gap-2 bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 mb-6 text-sm">
            <span class="material-symbols-outlined text-green-600 text-base">check_circle</span>
            <%= success %>
        </div>
    <% } %>
    <% if (error && error.length > 0) { %>
        <div class="flex items-center gap-2 bg-red-50 border border-red-200 text-error rounded-xl px-4 py-3 mb-6 text-sm">
            <span class="material-symbols-outlined text-base">error</span>
            <%= error %>
        </div>
    <% } %>

    <!-- Page header -->
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-on-surface">Dashboard Overview</h1>
        <p class="text-sm text-on-surface-variant mt-1">Manage all donors and hospitals from one place</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-2xl p-5 border border-outline-variant shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-primary text-xl filled">favorite</span>
                </div>
                <span class="text-xs font-medium text-primary bg-primary/10 px-2 py-1 rounded-full">Donors</span>
            </div>
            <p class="text-3xl font-bold text-on-surface"><%= donors.length %></p>
            <p class="text-xs text-on-surface-variant mt-1">Total registered donors</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-outline-variant shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-secondary/10 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-secondary text-xl filled">local_hospital</span>
                </div>
                <span class="text-xs font-medium text-secondary bg-secondary/10 px-2 py-1 rounded-full">Hospitals</span>
            </div>
            <p class="text-3xl font-bold text-on-surface"><%= hospitals.length %></p>
            <p class="text-xs text-on-surface-variant mt-1">Registered hospitals</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-outline-variant shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-green-600 text-xl filled">volunteer_activism</span>
                </div>
                <span class="text-xs font-medium text-green-700 bg-green-50 px-2 py-1 rounded-full">Active</span>
            </div>
            <p class="text-3xl font-bold text-on-surface"><%= activeDonors %></p>
            <p class="text-xs text-on-surface-variant mt-1">Active donors</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-outline-variant shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 bg-tertiary/10 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-tertiary text-xl">bloodtype</span>
                </div>
                <span class="text-xs font-medium text-tertiary bg-tertiary/10 px-2 py-1 rounded-full">Types</span>
            </div>
            <p class="text-3xl font-bold text-on-surface"><%= Object.keys(bloodGroupCounts).length %></p>
            <p class="text-xs text-on-surface-variant mt-1">Blood groups present</p>
        </div>
    </div>

    <!-- Two-column info row -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <!-- Blood Group Breakdown -->
        <div class="bg-white rounded-2xl p-6 border border-outline-variant shadow-sm">
            <h2 class="text-base font-semibold text-on-surface mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-lg">water_drop</span>
                Blood Group Distribution
            </h2>
            <% if (Object.keys(bloodGroupCounts).length === 0) { %>
                <p class="text-sm text-on-surface-variant text-center py-4">No donor data yet</p>
            <% } else { %>
                <div class="grid grid-cols-2 gap-2">
                    <% Object.entries(bloodGroupCounts).sort((a,b) => b[1]-a[1]).forEach(function([group, count]) { %>
                        <div class="flex items-center justify-between bg-surface-container-low rounded-lg px-3 py-2">
                            <span class="text-sm font-semibold text-primary"><%= group %></span>
                            <span class="text-xs font-medium text-on-surface-variant bg-white rounded-full px-2 py-0.5 border border-outline-variant"><%= count %></span>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Top Cities -->
        <div class="bg-white rounded-2xl p-6 border border-outline-variant shadow-sm">
            <h2 class="text-base font-semibold text-on-surface mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-lg">location_on</span>
                Top Donor Cities
            </h2>
            <% if (topCities.length === 0) { %>
                <p class="text-sm text-on-surface-variant text-center py-4">No city data yet</p>
            <% } else { %>
                <div class="space-y-3">
                    <% topCities.forEach(function([city, count], i) { %>
                        <div class="flex items-center gap-3">
                            <span class="w-5 h-5 rounded-full bg-secondary/10 text-secondary text-xs flex items-center justify-center font-bold flex-shrink-0"><%= i+1 %></span>
                            <div class="flex-1">
                                <div class="flex justify-between mb-1">
                                    <span class="text-sm font-medium text-on-surface"><%= city %></span>
                                    <span class="text-xs text-on-surface-variant"><%= count %></span>
                                </div>
                                <div class="h-1.5 bg-surface-container rounded-full overflow-hidden">
                                    <div class="h-full bg-secondary rounded-full" style="width: <%= Math.round((count / donors.length) * 100) %>%"></div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Tabs -->
    <div class="bg-white rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="flex border-b border-outline-variant px-2 pt-2 gap-1">
            <button onclick="switchTab('donors')" id="tab-donors" class="tab-btn active flex items-center gap-2 px-5 py-2.5 rounded-t-lg text-sm font-medium transition-all">
                <span class="material-symbols-outlined text-base">favorite</span>
                Donors (<%= donors.length %>)
            </button>
            <button onclick="switchTab('hospitals')" id="tab-hospitals" class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-t-lg text-sm font-medium transition-all text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low">
                <span class="material-symbols-outlined text-base">local_hospital</span>
                Hospitals (<%= hospitals.length %>)
            </button>
        </div>

        <!-- Donors Tab -->
        <div id="tab-content-donors" class="tab-content active p-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="relative flex-1 max-w-xs">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-base">search</span>
                    <input id="search-donors-input" type="text" placeholder="Search donors..." onkeyup="filterTable('donors-table', this.value)"
                        class="w-full h-10 pl-9 pr-4 bg-surface-container-low rounded-lg text-sm border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary/20 transition">
                </div>
                <span class="text-xs text-on-surface-variant"><%= donors.length %> total</span>
            </div>

            <% if (donors.length === 0) { %>
                <div class="text-center py-16 text-on-surface-variant">
                    <span class="material-symbols-outlined text-5xl mb-3 block opacity-30">person_search</span>
                    <p class="text-sm">No donors registered yet</p>
                </div>
            <% } else { %>
            <div class="overflow-x-auto rounded-xl border border-outline-variant">
                <table class="w-full text-sm" id="donors-table">
                    <thead>
                        <tr class="bg-surface-container-low text-on-surface-variant text-xs uppercase tracking-wide">
                            <th class="text-left px-4 py-3 font-semibold">Donor</th>
                            <th class="text-left px-4 py-3 font-semibold">Blood Group</th>
                            <th class="text-left px-4 py-3 font-semibold">City</th>
                            <th class="text-left px-4 py-3 font-semibold">Contact</th>
                            <th class="text-left px-4 py-3 font-semibold">Status</th>
                            <th class="text-left px-4 py-3 font-semibold">Last Donation</th>
                            <th class="text-center px-4 py-3 font-semibold">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        <% donors.forEach(function(d) { %>
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <% if (d.profilePic) { %>
                                        <img src="/uploads/<%= d.profilePic %>" class="w-9 h-9 rounded-full object-cover border border-outline-variant flex-shrink-0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                                        <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 hidden">
                                            <span class="material-symbols-outlined text-primary text-base">person</span>
                                        </div>
                                    <% } else { %>
                                        <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0">
                                            <span class="material-symbols-outlined text-primary text-base">person</span>
                                        </div>
                                    <% } %>
                                    <div>
                                        <p class="font-medium text-on-surface"><%= d.name || '—' %></p>
                                        <p class="text-xs text-on-surface-variant"><%= d.local && d.local.username ? d.local.username : (d.email || '—') %></p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                <% if (d.bloodGroup) { %>
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary"><%= d.bloodGroup %></span>
                                <% } else { %>
                                    <span class="text-on-surface-variant">—</span>
                                <% } %>
                            </td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= d.city || '—' %></td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= d.contactNumber || '—' %></td>
                            <td class="px-4 py-3">
                                <% if (d.activeStatus) { %>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700">
                                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>Active
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
                                        <span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span>Inactive
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-4 py-3 text-on-surface-variant text-xs">
                                <% if (d.dateOfLastDonation) { %>
                                    <%= new Date(d.dateOfLastDonation).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %>
                                <% } else { %>—<% } %>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <button onclick="confirmDelete('/admin/donors/<%= d._id %>/delete', '<%= (d.name || 'this donor').replace(/'/g, '') %>')"
                                    class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-error bg-red-50 hover:bg-red-100 rounded-lg transition-colors border border-red-100">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                    Delete
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

        <!-- Hospitals Tab -->
        <div id="tab-content-hospitals" class="tab-content p-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="relative flex-1 max-w-xs">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-base">search</span>
                    <input id="search-hospitals-input" type="text" placeholder="Search hospitals..." onkeyup="filterTable('hospitals-table', this.value)"
                        class="w-full h-10 pl-9 pr-4 bg-surface-container-low rounded-lg text-sm border border-outline-variant focus:border-secondary focus:ring-1 focus:ring-secondary/20 transition">
                </div>
                <span class="text-xs text-on-surface-variant"><%= hospitals.length %> total</span>
            </div>

            <% if (hospitals.length === 0) { %>
                <div class="text-center py-16 text-on-surface-variant">
                    <span class="material-symbols-outlined text-5xl mb-3 block opacity-30">local_hospital</span>
                    <p class="text-sm">No hospitals registered yet</p>
                </div>
            <% } else { %>
            <div class="overflow-x-auto rounded-xl border border-outline-variant">
                <table class="w-full text-sm" id="hospitals-table">
                    <thead>
                        <tr class="bg-surface-container-low text-on-surface-variant text-xs uppercase tracking-wide">
                            <th class="text-left px-4 py-3 font-semibold">Hospital</th>
                            <th class="text-left px-4 py-3 font-semibold">Username</th>
                            <th class="text-left px-4 py-3 font-semibold">City</th>
                            <th class="text-left px-4 py-3 font-semibold">Contact</th>
                            <th class="text-left px-4 py-3 font-semibold">Email</th>
                            <th class="text-center px-4 py-3 font-semibold">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        <% hospitals.forEach(function(h) { %>
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <% if (h.profilePic) { %>
                                        <img src="/uploads/<%= h.profilePic %>" class="w-9 h-9 rounded-full object-cover border border-outline-variant flex-shrink-0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                                        <div class="w-9 h-9 rounded-full bg-secondary/10 flex items-center justify-center flex-shrink-0 hidden">
                                            <span class="material-symbols-outlined text-secondary text-base">local_hospital</span>
                                        </div>
                                    <% } else { %>
                                        <div class="w-9 h-9 rounded-full bg-secondary/10 flex items-center justify-center flex-shrink-0">
                                            <span class="material-symbols-outlined text-secondary text-base">local_hospital</span>
                                        </div>
                                    <% } %>
                                    <div>
                                        <p class="font-medium text-on-surface"><%= h.name || '—' %></p>
                                        <p class="text-xs text-on-surface-variant"><%= h.address || '—' %></p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= h.local && h.local.username ? h.local.username : '—' %></td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= h.city || '—' %></td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= h.contactNumber || '—' %></td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= h.email || '—' %></td>
                            <td class="px-4 py-3 text-center">
                                <button onclick="confirmDelete('/admin/hospitals/<%= h._id %>/delete', '<%= (h.name || 'this hospital').replace(/'/g, '') %>')"
                                    class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-error bg-red-50 hover:bg-red-100 rounded-lg transition-colors border border-red-100">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                    Delete
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div id="delete-modal" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeDeleteModal()"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-6 relative z-10">
            <div class="flex flex-col items-center text-center mb-5">
                <div class="w-14 h-14 bg-red-50 rounded-full flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-error text-2xl">delete_forever</span>
                </div>
                <h3 class="text-base font-semibold text-on-surface">Confirm Deletion</h3>
                <p class="text-sm text-on-surface-variant mt-1">Are you sure you want to delete <strong id="delete-name"></strong>? This cannot be undone.</p>
            </div>
            <form id="delete-form" method="POST" class="flex gap-3">
                <button type="button" onclick="closeDeleteModal()" class="flex-1 h-10 bg-surface-container-low text-on-surface rounded-lg text-sm font-medium hover:bg-surface-container transition">Cancel</button>
                <button type="submit" class="flex-1 h-10 bg-error text-white rounded-lg text-sm font-medium hover:opacity-90 transition shadow-sm">Delete</button>
            </form>
        </div>
    </div>
</div>

<script>
function switchTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.classList.add('text-on-surface-variant', 'hover:text-on-surface', 'hover:bg-surface-container-low');
    });
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    document.getElementById('tab-' + tab).classList.remove('text-on-surface-variant', 'hover:text-on-surface', 'hover:bg-surface-container-low');
    document.getElementById('tab-content-' + tab).classList.add('active');
}

function filterTable(tableId, query) {
    const table = document.getElementById(tableId);
    if (!table) return;
    const rows = table.querySelectorAll('tbody tr');
    const q = query.toLowerCase();
    rows.forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}

function confirmDelete(action, name) {
    document.getElementById('delete-form').action = action;
    document.getElementById('delete-name').textContent = name;
    document.getElementById('delete-modal').classList.remove('hidden');
}

function closeDeleteModal() {
    document.getElementById('delete-modal').classList.add('hidden');
}

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeDeleteModal();
});
</script>

</body>
</html>
