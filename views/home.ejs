<% include partials/header %>

<main>
    <!-- Hero Section -->
    <section class="relative bg-background overflow-hidden">
        <div class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-24 flex flex-col md:flex-row items-center gap-12 md:gap-16">
            <div class="flex-1 space-y-6 md:space-y-8 z-10">
                <div class="inline-flex items-center px-4 py-2 bg-primary-fixed text-on-primary-fixed rounded-full text-label-md">
                    <span class="material-symbols-outlined mr-2 text-[18px]">emergency_home</span>
                    Urgently needed: O Negative
                </div>
                <h1 class="text-h1 text-on-surface font-h1">
                    Your contribution can <span class="text-primary">save a life</span> today
                </h1>
                <p class="text-body-lg text-on-surface-variant max-w-lg">
                    Connect with donors instantly or pledge your donation. Join network of Blood Buddy heroes and make an immediate impact in your community.
                </p>
                <div class="flex flex-wrap gap-4">
                    <% if(!currentUser){ %>
                        <a href="/auth/register" class="px-8 py-4 bg-primary text-on-primary rounded-lg font-h3 text-body-md hover:opacity-90 active:scale-95 transition-all shadow-md flex items-center gap-2">
                            <span class="material-symbols-outlined">volunteer_activism</span>
                            Donate Now
                        </a>
                        <button onclick="openModal('search-donors'); return false;" class="px-8 py-4 border-2 border-secondary text-secondary rounded-lg font-h3 text-body-md hover:bg-secondary/5 active:scale-95 transition-all flex items-center gap-2">
                            <span class="material-symbols-outlined">person_search</span>
                            Search Donor
                        </button>
                    <% } else { %>
                        <a href="/auth/logout" class="px-8 py-4 bg-primary text-on-primary rounded-lg font-h3 text-body-md hover:opacity-90 active:scale-95 transition-all shadow-md flex items-center gap-2">
                            <span class="material-symbols-outlined">logout</span>
                            Logout
                        </a>
                    <% } %>
                </div>
            </div>
            <div class="flex-1 relative">
                <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-secondary/10 rounded-full blur-3xl -z-10"></div>
                <!-- Hero Illustration -->
                <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-gradient-to-br from-white to-surface-container border border-outline-variant">
                    <svg viewBox="0 0 500 400" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
                        <!-- Background -->
                        <defs>
                            <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#fff5f5;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#e0f2fe;stop-opacity:1" />
                            </linearGradient>
                            <linearGradient id="heartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#ef4444;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#dc2626;stop-opacity:1" />
                            </linearGradient>
                            <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="4" stdDeviation="8" flood-opacity="0.15"/>
                            </filter>
                        </defs>
                        <rect width="500" height="400" fill="url(#bgGrad)"/>

                        <!-- Decorative circles -->
                        <circle cx="450" cy="50" r="80" fill="#fee2e2" opacity="0.6"/>
                        <circle cx="50" cy="350" r="60" fill="#e0f2fe" opacity="0.6"/>

                        <!-- Medical person silhouette -->
                        <g filter="url(#shadow)">
                            <!-- Body -->
                            <ellipse cx="250" cy="320" rx="90" ry="25" fill="#1e293b" opacity="0.1"/>
                            <path d="M200 200 Q200 280 250 300 Q300 280 300 200 L300 180 L200 180 Z" fill="#3b82f6"/>
                            <path d="M200 200 Q180 240 170 280 L330 280 Q320 240 300 200 Z" fill="#2563eb"/>

                            <!-- Head -->
                            <circle cx="250" cy="160" r="40" fill="#fbbf24"/>
                            <circle cx="250" cy="160" r="38" fill="#fcd34d"/>

                            <!-- Medical cap -->
                            <ellipse cx="250" cy="135" rx="35" ry="8" fill="#ffffff"/>
                            <rect x="215" y="115" width="70" height="20" rx="3" fill="#ffffff"/>

                            <!-- Medical cross on cap -->
                            <rect x="244" y="108" width="12" height="12" fill="#ef4444" rx="1"/>

                            <!-- Stethoscope -->
                            <path d="M230 180 Q210 220 220 260" stroke="#64748b" stroke-width="3" fill="none"/>
                            <circle cx="220" cy="260" r="8" fill="#94a3b8"/>
                            <path d="M270 180 Q290 220 280 260" stroke="#64748b" stroke-width="3" fill="none"/>

                            <!-- Blood bag -->
                            <g transform="translate(320, 150)">
                                <rect x="0" y="20" width="50" height="70" rx="5" fill="#fee2e2" stroke="#ef4444" stroke-width="2"/>
                                <path d="M20 20 L20 5 L30 5 L30 20" fill="none" stroke="#ef4444" stroke-width="3"/>
                                <!-- Blood droplet icon -->
                                <path d="M25 45 Q25 55 20 60 Q15 55 15 45 Q20 40 25 45" fill="#ef4444"/>
                                <text x="25" y="75" text-anchor="middle" fill="#ef4444" font-size="10" font-weight="bold">O+</text>
                            </g>

                            <!-- Heart with pulse -->
                            <g transform="translate(130, 140)">
                                <path d="M25 45 Q25 55 20 60 Q15 55 15 45 Q20 40 25 45" fill="#ef4444" transform="scale(2) translate(-10, -15)"/>
                                <!-- Heart shape -->
                                <path d="M25 40 C15 25 0 25 0 40 C0 55 25 70 25 70 C25 70 50 55 50 40 C50 25 35 25 25 40" fill="url(#heartGrad)" transform="scale(0.8) translate(6, 10)"/>
                            </g>

                            <!-- Pulse line -->
                            <polyline points="100,100 130,100 140,85 150,115 160,70 170,130 180,100 220,100" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </g>

                        <!-- Floating elements -->
                        <g>
                            <circle cx="380" cy="280" r="15" fill="#ef4444" opacity="0.2">
                                <animate attributeName="cy" values="280;270;280" dur="2s" repeatCount="indefinite"/>
                            </circle>
                            <circle cx="120" cy="120" r="10" fill="#3b82f6" opacity="0.2">
                                <animate attributeName="cy" values="120;110;120" dur="2.5s" repeatCount="indefinite"/>
                            </circle>
                            <circle cx="400" cy="180" r="8" fill="#fbbf24" opacity="0.3">
                                <animate attributeName="cy" values="180;170;180" dur="3s" repeatCount="indefinite"/>
                            </circle>
                        </g>
                    </svg>
                </div>
                <!-- Stats Floating Card -->
                <div class="absolute -bottom-4 -left-4 md:-bottom-8 md:-left-8 bg-white p-4 md:p-6 rounded-xl shadow-xl flex items-center gap-3 md:gap-4">
                    <div class="h-10 md:h-12 w-10 md:w-12 bg-secondary/10 rounded-full flex items-center justify-center text-secondary">
                        <span class="material-symbols-outlined text-lg md:text-2xl filled">favorite</span>
                    </div>
                    <div>
                        <p class="text-h2 md:text-[32px] text-primary">12,480+</p>
                        <p class="text-caption text-on-surface-variant">Lives impacted this year</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
        <div class="text-center mb-12">
            <h2 class="text-h2 text-on-surface mb-4">Our Services</h2>
            <p class="text-body-md text-on-surface-variant max-w-2xl mx-auto">Connecting donors, hospitals, and recipients to save lives together</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <!-- Donor Service -->
            <div class="bg-white p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow group">
                <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
                    <span class="material-symbols-outlined text-3xl text-primary">volunteer_activism</span>
                </div>
                <h3 class="text-h3 text-on-surface mb-3">DONOR</h3>
                <p class="text-body-md text-on-surface-variant leading-relaxed">Any one who wants to save life of any person can register as a donor and contribute to this noble cause.</p>
                <a href="/auth/register" class="inline-flex items-center mt-6 text-primary font-label-md hover:gap-2 transition-all gap-1">
                    Register Now <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            </div>
            <!-- Recipient Service -->
            <div class="bg-white p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow group">
                <div class="w-16 h-16 bg-secondary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-secondary/20 transition-colors">
                    <span class="material-symbols-outlined text-3xl text-secondary">diversity_3</span>
                </div>
                <h3 class="text-h3 text-on-surface mb-3">RECEIVER</h3>
                <p class="text-body-md text-on-surface-variant leading-relaxed">Any one who is in need can get blood easily from our extensive donor network across all cities.</p>
                <button onclick="openModal('search-donors'); return false;" class="inline-flex items-center mt-6 text-secondary font-label-md hover:gap-2 transition-all gap-1">
                    Find Donor <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </div>
            <!-- Hospitals Service -->
            <div class="bg-white p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow group">
                <div class="w-16 h-16 bg-tertiary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-tertiary/20 transition-colors">
                    <span class="material-symbols-outlined text-3xl text-tertiary">local_hospital</span>
                </div>
                <h3 class="text-h3 text-on-surface mb-3">HOSPITALS</h3>
                <p class="text-body-md text-on-surface-variant leading-relaxed">A lot of hospitals are linked with our app and receiver can use their blood bank to find compatible donors.</p>
                <a href="/auth/registerHospital" class="inline-flex items-center mt-6 text-tertiary font-label-md hover:gap-2 transition-all gap-1">
                    Register Hospital <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Urgent Requests Banner -->
    <% if (typeof urgentRequests !== 'undefined' && urgentRequests.length > 0) { %>
    <section class="max-w-[1280px] mx-auto px-6 md:px-10 pt-6">
        <div class="bg-primary/5 border border-primary/20 rounded-2xl p-5">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center flex-shrink-0 animate-pulse">
                        <span class="material-symbols-outlined text-white text-lg">emergency</span>
                    </div>
                    <div>
                        <p class="font-semibold text-primary text-base"><%= urgentRequests.length %> urgent blood request<%= urgentRequests.length !== 1 ? 's' : '' %> near you</p>
                        <p class="text-sm text-on-surface-variant">People in your community urgently need donors right now</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <% urgentRequests.slice(0, 3).forEach(function(r) { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-primary/20 rounded-lg text-sm font-medium text-on-surface shadow-sm">
                        <span class="font-bold text-primary"><%= r.bloodGroup %></span>
                        <span class="text-on-surface-variant">· <%= r.city %></span>
                        <% if (r.urgency === 'critical') { %>
                            <span class="w-1.5 h-1.5 bg-primary rounded-full inline-block animate-pulse"></span>
                        <% } %>
                    </span>
                    <% }) %>
                    <a href="/requests" class="inline-flex items-center gap-1 px-3 py-1.5 bg-primary text-white rounded-lg text-sm font-medium hover:opacity-90 transition-all">
                        View all <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Hospital Bulk Needs Teaser -->
    <% if (typeof topHospNeeds !== 'undefined' && topHospNeeds.length > 0) { %>
    <section class="max-w-[1280px] mx-auto px-6 md:px-10 pt-4">
        <div class="bg-secondary/5 border border-secondary/20 rounded-2xl p-5">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-secondary rounded-xl flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-white text-lg">local_hospital</span>
                    </div>
                    <div>
                        <p class="font-semibold text-secondary text-base">Hospitals urgently need blood</p>
                        <p class="text-sm text-on-surface-variant">Registered hospitals are running short — your donation makes a direct impact</p>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2">
                    <% topHospNeeds.slice(0, 3).forEach(function(n) { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-secondary/20 rounded-lg text-sm font-medium text-on-surface shadow-sm">
                        <span class="font-bold text-primary"><%= n.bloodGroup %></span>
                        <span class="text-on-surface-variant">· <%= n.unitsNeeded %>u · <%= n.hospitalName.split(' ').slice(0,2).join(' ') %></span>
                        <% if (n.urgency === 'critical') { %>
                            <span class="w-1.5 h-1.5 bg-primary rounded-full inline-block animate-pulse"></span>
                        <% } %>
                    </span>
                    <% }) %>
                    <a href="/hospital-needs" class="inline-flex items-center gap-1 px-3 py-1.5 bg-secondary text-white rounded-lg text-sm font-medium hover:opacity-90 transition-all">
                        View all <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Stats Section -->
    <section class="bg-inverse-surface text-inverse-on-surface py-16 md:py-20">
        <div class="max-w-[1280px] mx-auto px-6 md:px-10">
            <div class="text-center mb-10">
                <h2 class="text-h2 text-inverse-on-surface mb-2">Our Impact</h2>
                <p class="text-body-md text-inverse-on-surface opacity-80">Numbers that speak about our community's contribution</p>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 text-center">
                <div class="space-y-3">
                    <p class="text-[40px] md:text-[48px] font-extrabold text-primary-fixed">105+</p>
                    <p class="text-label-md uppercase tracking-wider">Users</p>
                </div>
                <div class="space-y-3">
                    <p class="text-[40px] md:text-[48px] font-extrabold text-primary-fixed">75+</p>
                    <p class="text-label-md uppercase tracking-wider">Donors</p>
                </div>
                <div class="space-y-3">
                    <p class="text-[40px] md:text-[48px] font-extrabold text-primary-fixed">50+</p>
                    <p class="text-label-md uppercase tracking-wider">Hospitals</p>
                </div>
                <div class="space-y-3">
                    <p class="text-[40px] md:text-[48px] font-extrabold text-primary-fixed">42+</p>
                    <p class="text-label-md uppercase tracking-wider">NGO's</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
        <div class="bg-white rounded-2xl p-8 md:p-12 border border-outline-variant shadow-lg">
            <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-start">
                <div class="flex-1">
                    <h2 class="text-h2 text-on-surface mb-4">About Blood Buddy</h2>
                    <p class="text-body-lg text-on-surface-variant leading-relaxed mb-6">
                        In our country we lose millions of lives each year just because of lack of availability of blood. This is so serious and saddening that we are a group of 1.3 billion people and still we are not able to save lives.
                    </p>
                    <p class="text-body-lg text-on-surface-variant leading-relaxed">
                        Our project with help of technology will connect all people, hospitals & NGO's who require and are willing to donate blood. Together, we can bridge this gap and save countless lives.
                    </p>
                </div>
                <div class="flex-shrink-0">
                    <img src="/img/image2.jpg" alt="Blood donation awareness" class="w-full max-w-xs rounded-xl shadow-lg">
                </div>
            </div>
            <div class="mt-8 text-center">
                <a href="/auth/register" class="inline-flex items-center px-8 py-4 bg-primary text-on-primary rounded-lg font-h3 text-body-md hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-primary/20 gap-2">
                    <span class="material-symbols-outlined">favorite</span>
                    Start Saving Lives
                </a>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
        <div class="text-center mb-12">
            <h2 class="text-h2 text-on-surface mb-4">What Our Users Say</h2>
            <p class="text-body-md text-on-surface-variant">Real stories from our community of life-savers</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
            <!-- Testimonial 1 -->
            <div class="bg-white p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-4 mb-6">
                    <img src="/img/users/client-1.jpg" alt="Daniel Watrous" class="w-16 h-16 rounded-full object-cover border-2 border-surface-container-low">
                    <div>
                        <h4 class="text-label-md text-on-surface font-semibold">Daniel Watrous</h4>
                        <p class="text-caption text-on-surface-variant">Donor</p>
                    </div>
                </div>
                <blockquote class="text-body-md text-on-surface-variant italic leading-relaxed">
                    "Awesome application for helping needy people. All people who wants blood with in a short time can have benefit from here."
                </blockquote>
            </div>
            <!-- Testimonial 2 -->
            <div class="bg-white p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-4 mb-6">
                    <img src="/img/users/client-2.jpg" alt="Sarah Johnson" class="w-16 h-16 rounded-full object-cover border-2 border-surface-container-low">
                    <div>
                        <h4 class="text-label-md text-on-surface font-semibold">Sarah Johnson</h4>
                        <p class="text-caption text-on-surface-variant">Donor</p>
                    </div>
                </div>
                <blockquote class="text-body-md text-on-surface-variant italic leading-relaxed">
                    "I donated blood to a needy patient undergoing open heart surgery at GKNM Hospital, Coimbatore. I am happy to be associated with Blood Buddy and thank them for giving me this opportunity."
                </blockquote>
            </div>
            <!-- Testimonial 3 -->
            <div class="bg-white p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center gap-4 mb-6">
                    <img src="/img/users/client-3.jpg" alt="Michael Chen" class="w-16 h-16 rounded-full object-cover border-2 border-surface-container-low">
                    <div>
                        <h4 class="text-label-md text-on-surface font-semibold">Michael Chen</h4>
                        <p class="text-caption text-on-surface-variant">Donor</p>
                    </div>
                </div>
                <blockquote class="text-body-md text-on-surface-variant italic leading-relaxed">
                    "Had an amazing experience with Blood Buddy. Saved life of my brother back a few days. Now I am also a registered donor on it. Thank you so much!"
                </blockquote>
            </div>
        </div>
    </section>

    <!-- Upcoming Blood Camps -->
    <% if (typeof upcomingCamps !== 'undefined' && upcomingCamps.length > 0) { %>
    <section class="max-w-[1280px] mx-auto px-6 md:px-10 py-12">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-h2 text-on-surface">Upcoming Blood Camps</h2>
                <p class="text-body-md text-on-surface-variant mt-1">Donation drives near you — walk in and save a life</p>
            </div>
            <a href="/camps" class="inline-flex items-center gap-1 text-secondary font-medium hover:underline text-sm">
                View all camps <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% upcomingCamps.forEach(function(camp) {
                var campDate = new Date(camp.date);
                var daysLeft = Math.ceil((campDate - new Date()) / (1000*60*60*24));
            %>
            <div class="bg-white border border-outline-variant rounded-2xl shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col gap-4">
                <div class="flex items-start justify-between">
                    <div class="flex flex-col items-center bg-secondary/10 text-secondary rounded-xl px-4 py-2 min-w-[56px] text-center">
                        <span class="text-xs font-semibold uppercase tracking-wide"><%= campDate.toLocaleString('default',{month:'short'}) %></span>
                        <span class="text-2xl font-extrabold leading-tight"><%= campDate.getDate() %></span>
                    </div>
                    <% if (daysLeft <= 7) { %>
                    <span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-semibold border border-amber-100">
                        <%= daysLeft === 0 ? 'Today!' : daysLeft === 1 ? 'Tomorrow' : 'In ' + daysLeft + ' days' %>
                    </span>
                    <% } %>
                </div>
                <div>
                    <h3 class="text-label-md text-on-surface font-semibold mb-1"><%= camp.title %></h3>
                    <p class="text-caption text-secondary mb-2"><%= camp.organizer %></p>
                    <div class="flex items-center gap-1.5 text-caption text-on-surface-variant">
                        <span class="material-symbols-outlined text-sm">location_on</span>
                        <%= camp.address %>, <%= camp.city %>
                    </div>
                </div>
                <a href="tel:<%= camp.contactNumber %>" class="mt-auto inline-flex items-center gap-1.5 px-4 py-2 bg-secondary/10 text-secondary rounded-lg text-sm font-medium hover:bg-secondary/20 transition-colors">
                    <span class="material-symbols-outlined text-base">call</span>
                    <%= camp.contactNumber %>
                </a>
            </div>
            <% }) %>
        </div>
    </section>
    <% } %>

    <!-- Quick Find Widget -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-10 -mt-8 pb-20">
        <div class="bg-white rounded-2xl shadow-2xl p-6 md:p-8 border border-outline-variant">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">search</span>
                </div>
                <h3 class="text-h3 text-on-surface">Find a donor instantly</h3>
            </div>
            <form action="/search" method="post" class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="space-y-2">
                    <label class="text-label-md text-on-surface-variant block">Blood Type</label>
                    <select name="bloodGroup" class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-secondary">
                        <option value="0">Any</option>
                        <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                        <option>B+</option><option>B-</option><option>A1B+</option><option>A1B-</option>
                        <option>A2B+</option><option>A2B-</option><option>AB+</option><option>AB-</option>
                        <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-label-md text-on-surface-variant block">Location</label>
                    <div class="relative">
                        <select name="city" class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg pl-10 focus:ring-2 focus:ring-secondary appearance-none">
                            <option value="0">Select City</option>
