<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20 min-h-[calc(100vh-180px)] flex items-center justify-center">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="w-20 h-20 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-secondary text-4xl">local_hospital</span>
            </div>
            <h1 class="text-h2 text-on-surface mb-2">Hospital Login</h1>
            <p class="text-body-md text-on-surface-variant">Welcome back! Sign in to manage your blood inventory.</p>
        </div>

        <div class="bg-white rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.1)] p-8">
            <form action="/auth/loginHospital" method="post" class="space-y-6">
                <div class="space-y-2">
                    <label for="hosp-username" class="text-label-md text-on-surface-variant block">Username</label>
                    <input id="hosp-username" type="text" name="username" placeholder="Enter your username" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                </div>
                <div class="space-y-2">
                    <label for="hosp-password" class="text-label-md text-on-surface-variant block">Password</label>
                    <input id="hosp-password" type="password" name="password" placeholder="Enter your password" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                </div>
                <button type="submit" class="w-full h-12 bg-secondary text-on-secondary rounded-lg font-label-md hover:opacity-90 active:scale-[0.98] transition-all duration-300 shadow-lg shadow-secondary/20">
                    Login
                </button>
            </form>

            <div class="mt-6 text-center space-y-2">
                <p class="text-caption text-on-surface-variant">Don't have an account?</p>
                <a href="/auth/registerHospital" class="inline-flex items-center text-secondary font-label-md hover:gap-1 transition-all gap-0.5">
                    Register Hospital <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>
        </div>

        <div class="mt-8 text-center">
            <p class="text-body-md text-on-surface-variant">Are you a donor?</p>
            <a href="/login" class="inline-flex items-center mt-2 text-primary font-label-md hover:gap-1 transition-all gap-0.5">
                Donor Login <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
        </div>
    </div>
</main>

<% include partials/footer %>
