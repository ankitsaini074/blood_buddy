                                <span class="w-6 h-6 bg-primary/10 rounded flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary text-sm">bloodtype</span>
                                </span>
                                A+
                            </label>
                            <input type="text" name="A" value="<%= data.A %>" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                        </div>

                        <!-- A- -->
