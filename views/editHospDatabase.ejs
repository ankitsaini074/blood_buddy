<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-secondary text-4xl">inventory_2</span>
            </div>
            <h1 class="text-h1 text-on-surface mb-3">Update Blood Inventory</h1>
            <p class="text-body-md text-on-surface-variant">Keep your blood stock levels updated to help patients find available blood types.</p>
        </div>

