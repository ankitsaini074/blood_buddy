<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
        <div>
            <h1 class="text-h1 text-on-surface mb-2">Blood Donation Camps</h1>
            <p class="text-body-lg text-on-surface-variant">Upcoming donation drives and camps in your area</p>
        </div>
        <% if (currentUser && currentUser.userType === 'Hospital') { %>
        <button onclick="document.getElementById('postCampModal').classList.remove('hidden')"
            class="inline-flex items-center gap-2 px-6 py-3 bg-secondary text-on-secondary rounded-xl font-semibold shadow-lg shadow-secondary/20 hover:opacity-90 transition-all">
            <span class="material-symbols-outlined">add_circle</span>
            Post a Camp
        </button>
        <% } %>
    </div>

    <!-- Stats bar -->
    <div class="flex gap-4 mb-8 flex-wrap">
        <div class="flex items-center gap-2 px-4 py-2.5 bg-white border border-outline-variant rounded-xl shadow-sm text-sm font-medium text-on-surface">
            <span class="material-symbols-outlined text-secondary text-base">event</span>
            <span><%= camps.length %> upcoming camp<%= camps.length !== 1 ? 's' : '' %></span>
        </div>
        <% if (currentUser && currentUser.userType !== 'Hospital') { %>
        <div class="flex items-center gap-2 px-4 py-2.5 bg-white border border-outline-variant rounded-xl shadow-sm text-sm text-on-surface-variant">
            <span class="material-symbols-outlined text-base">info</span>
            Hospitals post camps. Register your hospital to host a drive.
        </div>
        <% } %>
    </div>

    <!-- Upcoming Camps Grid -->
    <% if (camps.length === 0) { %>
    <div class="bg-white border border-outline-variant rounded-2xl p-16 text-center">
        <span class="material-symbols-outlined text-5xl text-on-surface-variant opacity-30 block mb-3">event_busy</span>
        <p class="text-on-surface-variant text-base">No upcoming camps right now</p>
        <p class="text-sm text-on-surface-variant mt-1">Check back soon or register your hospital to host one</p>
    </div>
    <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <% camps.forEach(function(camp) {
            const campDate = new Date(camp.date);
            const now = new Date();
            const daysLeft = Math.ceil((campDate - now) / (1000 * 60 * 60 * 24));
        %>
        <div class="bg-white border border-outline-variant rounded-2xl shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col">
            <!-- Colour header strip -->
            <div class="h-2 bg-gradient-to-r from-secondary to-tertiary"></div>
            <div class="p-6 flex flex-col flex-1">
                <!-- Date badge + days left -->
                <div class="flex items-start justify-between mb-4">
                    <div class="flex flex-col items-center bg-secondary/10 text-secondary rounded-xl px-4 py-2 min-w-[56px] text-center">
                        <span class="text-xs font-semibold uppercase tracking-wide"><%= campDate.toLocaleString('default',{month:'short'}) %></span>
                        <span class="text-2xl font-extrabold leading-tight"><%= campDate.getDate() %></span>
                    </div>
                    <% if (daysLeft <= 7) { %>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-semibold border border-amber-200">
                        <span class="w-1.5 h-1.5 bg-amber-500 rounded-full inline-block animate-pulse"></span>
                        <%= daysLeft === 0 ? 'Today!' : daysLeft === 1 ? 'Tomorrow' : 'In ' + daysLeft + ' days' %>
                    </span>
                    <% } %>
                </div>

                <h3 class="text-h3 text-on-surface mb-1 flex-1"><%= camp.title %></h3>
                <p class="text-sm text-secondary font-medium mb-3"><%= camp.organizer %></p>

                <% if (camp.description) { %>
                <p class="text-body-md text-on-surface-variant mb-4 line-clamp-2"><%= camp.description %></p>
                <% } %>

                <div class="space-y-2 mt-auto pt-4 border-t border-outline-variant/40">
                    <div class="flex items-center gap-2 text-sm text-on-surface-variant">
                        <span class="material-symbols-outlined text-base text-secondary">location_on</span>
                        <span><%= camp.address %>, <%= camp.city %></span>
                    </div>
                    <div class="flex items-center gap-2 text-sm text-on-surface-variant">
                        <span class="material-symbols-outlined text-base text-secondary">schedule</span>
                        <span><%= campDate.toLocaleDateString('en-IN',{weekday:'short',day:'2-digit',month:'short',year:'numeric'}) %></span>
                        <% if (camp.endDate) { %>
                        <span>– <%= new Date(camp.endDate).toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) %></span>
                        <% } %>
                    </div>
                    <div class="flex items-center gap-2 text-sm">
                        <span class="material-symbols-outlined text-base text-secondary">call</span>
                        <a href="tel:<%= camp.contactNumber %>" class="text-secondary hover:underline font-medium"><%= camp.contactNumber %></a>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>

    <!-- Past Camps -->
    <% if (pastCamps.length > 0) { %>
    <div class="mt-10">
        <h2 class="text-h2 text-on-surface mb-6">Past Camps</h2>
        <div class="bg-white border border-outline-variant rounded-2xl overflow-hidden shadow-sm">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant text-xs uppercase tracking-wide">
                        <th class="text-left px-5 py-3 font-semibold">Camp</th>
                        <th class="text-left px-5 py-3 font-semibold">Organizer</th>
                        <th class="text-left px-5 py-3 font-semibold">City</th>
                        <th class="text-left px-5 py-3 font-semibold">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    <% pastCamps.forEach(function(c) { %>
                    <tr class="hover:bg-surface-container-low/50 transition-colors">
                        <td class="px-5 py-3 font-medium text-on-surface-variant"><%= c.title %></td>
                        <td class="px-5 py-3 text-on-surface-variant"><%= c.organizer %></td>
                        <td class="px-5 py-3 text-on-surface-variant"><%= c.city %></td>
                        <td class="px-5 py-3 text-on-surface-variant"><%= new Date(c.date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>
</main>

<!-- Post Camp Modal (hospitals only) -->
<% if (currentUser && currentUser.userType === 'Hospital') { %>
<div id="postCampModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-8 relative">
        <button onclick="document.getElementById('postCampModal').classList.add('hidden')"
            class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-secondary/10 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-secondary">event</span>
            </div>
            <h2 class="text-h2 text-on-surface">Post a Blood Camp</h2>
        </div>
        <form action="/camps/new" method="POST" class="space-y-4">
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Camp Title *</label>
                <input type="text" name="title" required placeholder="e.g. Annual Blood Donation Drive 2026"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">Start Date *</label>
                    <input type="date" name="date" required
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
                </div>
                <div>
                    <label class="text-sm font-medium text-on-surface-variant block mb-1">End Date (optional)</label>
                    <input type="date" name="endDate"
                        class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
                </div>
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">City *</label>
                <input type="text" name="city" required value="<%= currentUser.city || '' %>"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Venue / Address *</label>
                <input type="text" name="address" required placeholder="Hall or building name + street"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Contact Number *</label>
                <input type="tel" name="contactNumber" required value="<%= currentUser.contactNumber || '' %>"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Description (optional)</label>
                <textarea name="description" rows="2" placeholder="Any extra details for donors…"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-secondary resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-secondary text-on-secondary rounded-xl font-semibold hover:opacity-90 transition-all mt-2">
                Post Camp
            </button>
        </form>
    </div>
</div>
<% } %>

<% include partials/footer %>
