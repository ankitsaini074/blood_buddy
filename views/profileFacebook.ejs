<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
        <!-- Profile Header -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-outline-variant">
            <!-- Banner -->
            <div class="h-32 bg-gradient-to-r from-[#1877F2] to-[#42b72a]"></div>

            <!-- Profile Info -->
            <div class="px-6 md:px-10 pb-8">
                <div class="flex flex-col md:flex-row items-start md:items-end -mt-16 gap-6">
                    <!-- Profile Image -->
                    <div class="relative">
                        <div class="w-32 h-32 rounded-full border-4 border-surface-container-lowest overflow-hidden shadow-lg bg-surface-container-low flex items-center justify-center">
                            <span class="material-symbols-outlined text-5xl text-[#1877F2]">facebook</span>
                        </div>
                        <span class="absolute bottom-2 right-2 w-6 h-6 bg-green-500 rounded-full border-4 border-white"></span>
                    </div>

                    <!-- Name & Status -->
                    <div class="flex-1">
                        <div class="flex flex-wrap items-center gap-3 mb-2">
                            <h1 class="text-h2 text-on-surface"><%= donor.facebook.name %></h1>
                            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-label-md font-semibold flex items-center gap-1">
                                <span class="material-symbols-outlined text-[16px]">verified</span>
                                Active
                            </span>
                        </div>
                        <p class="text-body-md text-on-surface-variant flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#1877F2]">facebook</span>
                            Connected with Facebook
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex gap-3">
                        <a href="/edit" class="inline-flex items-center px-6 py-3 bg-primary text-on-primary rounded-lg font-label-md hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-primary/20 gap-2">
                            <span class="material-symbols-outlined">edit</span>
                            Complete Profile
                        </a>
                        <a href="/auth/logout" class="inline-flex items-center px-6 py-3 bg-surface-container-low text-on-surface rounded-lg font-label-md hover:bg-surface-container transition-colors gap-2">
                            <span class="material-symbols-outlined">logout</span>
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info Card -->
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6 mt-6">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 bg-[#1877F2]/10 rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-[#1877F2]">info</span>
                </div>
                <h3 class="text-h3 text-on-surface">Account Information</h3>
            </div>
            <div class="space-y-4">
                <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                    <span class="text-body-md text-on-surface-variant">Facebook ID</span>
                    <span class="text-body-md text-on-surface font-medium"><%= donor.facebook.id %></span>
                </div>
                <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                    <span class="text-body-md text-on-surface-variant">Email</span>
                    <span class="text-body-md text-on-surface font-medium"><%= donor.facebook.email %></span>
                </div>
                <div class="flex justify-between items-center py-3">
                    <span class="text-body-md text-on-surface-variant">Status</span>
                    <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-label-md font-semibold">
                        Profile Incomplete
                    </span>
                </div>
            </div>
        </div>

        <!-- Call to Action -->
        <div class="bg-primary/5 rounded-xl border border-primary/20 p-8 mt-6 text-center">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-3xl text-primary">volunteer_activism</span>
            </div>
            <h3 class="text-h2 text-on-surface mb-3">Complete Your Donor Profile</h3>
            <p class="text-body-md text-on-surface-variant mb-6 max-w-lg mx-auto">
                Add your blood group, location, and contact details to become visible to patients in need.
            </p>
            <a href="/edit" class="inline-flex items-center px-8 py-4 bg-primary text-on-primary rounded-lg font-h3 text-body-md hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-primary/20 gap-2">
                <span class="material-symbols-outlined">edit</span>
                Complete Profile Now
            </a>
        </div>
    </div>
</main>

<% include partials/footer %>
