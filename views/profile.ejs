<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
        <!-- Profile Header -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-outline-variant">
            <!-- Banner -->
            <div class="h-32 bg-gradient-to-r from-primary to-primary-container"></div>

            <!-- Profile Info -->
            <div class="px-6 md:px-10 pb-8">
                <div class="flex flex-col md:flex-row items-start md:items-end -mt-16 gap-6">
                    <!-- Profile Image -->
                    <div class="relative">
                        <div class="w-32 h-32 rounded-full border-4 border-surface-container-lowest overflow-hidden shadow-lg">
                            <% var file = 'uploads/' + donor.profilePic; %>
                            <img src="<%= file %>" alt="Profile" class="w-full h-full object-cover">
                        </div>
                        <span class="absolute bottom-2 right-2 w-6 h-6 <%= donor.activeStatus ? 'bg-green-500' : 'bg-gray-400' %> rounded-full border-4 border-white"></span>
                    </div>

                    <!-- Name & Status -->
                    <div class="flex-1">
                        <div class="flex flex-wrap items-center gap-3 mb-2">
                            <h1 class="text-h2 text-on-surface"><%= donor.name %></h1>
                            <% if(donor.activeStatus == true) { %>
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-label-md font-semibold flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">verified</span>
                                    Active
                                </span>
                            <% } else { %>
                                <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-label-md font-semibold">Inactive</span>
                            <% } %>
                        </div>
                        <p class="text-body-md text-on-surface-variant">@<%= donor.local.username %></p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex gap-3">
                        <a href="/edit" class="inline-flex items-center px-6 py-3 bg-primary text-on-primary rounded-lg font-label-md hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-primary/20 gap-2">
                            <span class="material-symbols-outlined">edit</span>
                            Edit Profile
                        </a>
                        <a href="/auth/logout" class="inline-flex items-center px-6 py-3 bg-surface-container-low text-on-surface rounded-lg font-label-md hover:bg-surface-container transition-colors gap-2">
                            <span class="material-symbols-outlined">logout</span>
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
            <!-- Personal Info -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">person</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">Personal Information</h3>
                </div>
                <div class="space-y-4">
                    <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                        <span class="text-body-md text-on-surface-variant">Email</span>
                        <span class="text-body-md text-on-surface font-medium"><%= donor.email %></span>
                    </div>
                    <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                        <span class="text-body-md text-on-surface-variant">Contact Number</span>
                        <span class="text-body-md text-on-surface font-medium"><%= donor.contactNumber %></span>
                    </div>
                    <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                        <span class="text-body-md text-on-surface-variant">Date of Birth</span>
                        <span class="text-body-md text-on-surface font-medium"><%= donor.dob %></span>
                    </div>
                    <div class="flex justify-between items-center py-3">
                        <span class="text-body-md text-on-surface-variant">Gender</span>
                        <span class="text-body-md text-on-surface font-medium">
                            <% if(donor.gender === 'M') { %>Male<% } else if(donor.gender === 'F') { %>Female<% } else { %>Other<% } %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Blood & Location Info -->
            <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-secondary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-secondary">bloodtype</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">Blood & Location</h3>
                </div>
                <div class="space-y-4">
                    <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                        <span class="text-body-md text-on-surface-variant">Blood Group</span>
                        <span class="inline-flex items-center px-4 py-2 bg-primary/10 text-primary rounded-full font-h3 font-semibold">
                            <%= donor.bloodGroup %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center py-3 border-b border-outline-variant/30">
                        <span class="text-body-md text-on-surface-variant">Last Donation</span>
                        <span class="text-body-md text-on-surface font-medium"><%= donor.dateOfLastDonation || 'Not recorded' %></span>
                    </div>
                    <div class="flex justify-between items-center py-3">
                        <span class="text-body-md text-on-surface-variant">City</span>
                        <span class="text-body-md text-on-surface font-medium"><%= donor.city %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Card -->
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6 mt-6">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-tertiary/10 rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-tertiary">location_on</span>
                </div>
                <h3 class="text-h3 text-on-surface">Address</h3>
            </div>
            <p class="text-body-md text-on-surface"><%= donor.address %></p>
        </div>

        <%
            var logCount = (donor.donationLog && donor.donationLog.length) || 0;
            var badges = [];
            if (logCount >= 1)  badges.push({ label: 'First Drop',    icon: 'water_drop',        color: 'text-primary bg-primary/10',   tip: '1 donation' });
            if (logCount >= 3)  badges.push({ label: 'Regular Giver', icon: 'favorite',           color: 'text-amber-600 bg-amber-50',   tip: '3 donations' });
            if (logCount >= 5)  badges.push({ label: 'Lifesaver',     icon: 'star',               color: 'text-yellow-500 bg-yellow-50', tip: '5 donations' });
            if (logCount >= 10) badges.push({ label: 'Hero',          icon: 'emoji_events',       color: 'text-purple-600 bg-purple-50', tip: '10 donations' });
            if (logCount >= 25) badges.push({ label: 'Legend',        icon: 'military_tech',      color: 'text-rose-600 bg-rose-50',     tip: '25 donations' });
        %>

        <!-- Badges -->
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6 mt-6">
            <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-amber-50 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-amber-500">military_tech</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">Badges</h3>
                </div>
                <span class="text-sm text-on-surface-variant"><%= logCount %> donation<%= logCount !== 1 ? 's' : '' %> logged</span>
            </div>
            <% if (badges.length === 0) { %>
            <div class="text-center py-6 text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl opacity-20 block mb-2">military_tech</span>
                <p class="text-sm">Log your first donation to earn a badge!</p>
            </div>
            <% } else { %>
            <div class="flex flex-wrap gap-3">
                <% badges.forEach(function(b) { %>
                <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-outline-variant/40 <%= b.color %>">
                    <span class="material-symbols-outlined text-lg filled"><%= b.icon %></span>
                    <div>
                        <p class="text-sm font-semibold leading-tight"><%= b.label %></p>
                        <p class="text-xs opacity-70"><%= b.tip %></p>
                    </div>
                </div>
                <% }) %>
                <% if (logCount < 25) {
                    var nextBadge = logCount < 3 ? {label:'Regular Giver', need:3} : logCount < 5 ? {label:'Lifesaver', need:5} : logCount < 10 ? {label:'Hero', need:10} : {label:'Legend', need:25};
                %>
                <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-dashed border-outline-variant text-on-surface-variant opacity-60">
                    <span class="material-symbols-outlined text-lg">lock</span>
                    <div>
                        <p class="text-sm font-semibold"><%= nextBadge.label %></p>
                        <p class="text-xs"><%= nextBadge.need - logCount %> more to unlock</p>
                    </div>
                </div>
                <% } %>
            </div>
            <% } %>
        </div>

        <!-- Donation History -->
        <div class="bg-white rounded-xl border border-outline-variant shadow-sm p-6 mt-6">
            <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">history</span>
                    </div>
                    <h3 class="text-h3 text-on-surface">Donation History</h3>
                </div>
                <button onclick="document.getElementById('logDonationModal').classList.remove('hidden')"
                    class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary text-on-primary rounded-lg text-sm font-semibold hover:opacity-90 transition-all shadow-md shadow-primary/20">
                    <span class="material-symbols-outlined text-base">add</span>
                    Log Donation
                </button>
            </div>
            <% if (!donor.donationLog || donor.donationLog.length === 0) { %>
            <div class="text-center py-8 text-on-surface-variant">
                <span class="material-symbols-outlined text-4xl opacity-20 block mb-2">water_drop</span>
                <p class="text-sm">No donations logged yet. Every drop counts!</p>
            </div>
            <% } else { %>
            <div class="overflow-x-auto rounded-xl border border-outline-variant">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-surface-container-low text-on-surface-variant text-xs uppercase tracking-wide">
                            <th class="text-left px-4 py-3 font-semibold">#</th>
                            <th class="text-left px-4 py-3 font-semibold">Date</th>
                            <th class="text-left px-4 py-3 font-semibold">Location</th>
                            <th class="text-left px-4 py-3 font-semibold">Notes</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        <% donor.donationLog.forEach(function(entry, idx) { %>
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="px-4 py-3">
                                <span class="w-7 h-7 bg-primary/10 text-primary rounded-full flex items-center justify-center text-xs font-bold">
                                    <%= donor.donationLog.length - idx %>
                                </span>
                            </td>
                            <td class="px-4 py-3 font-medium text-on-surface">
                                <%= new Date(entry.date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %>
                            </td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= entry.location || '—' %></td>
                            <td class="px-4 py-3 text-on-surface-variant"><%= entry.notes || '—' %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>
    </div>
</main>

<!-- Log Donation Modal -->
<div id="logDonationModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 relative">
        <button onclick="document.getElementById('logDonationModal').classList.add('hidden')"
            class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-container-low transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">water_drop</span>
            </div>
            <div>
                <h2 class="text-h3 text-on-surface">Log a Donation</h2>
                <p class="text-sm text-on-surface-variant">Record a blood donation you made</p>
            </div>
        </div>
        <form action="/edit/logDonation" method="POST" class="space-y-4">
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Donation Date *</label>
                <input type="date" name="date" required
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Location / Hospital</label>
                <input type="text" name="location" placeholder="e.g. City Blood Bank, Apollo Hospital"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary">
            </div>
            <div>
                <label class="text-sm font-medium text-on-surface-variant block mb-1">Notes (optional)</label>
                <textarea name="notes" rows="2" placeholder="Any extra details…"
                    class="w-full px-4 py-3 rounded-lg bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary resize-none"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-primary text-on-primary rounded-xl font-semibold hover:opacity-90 transition-all">
                Save Donation
            </button>
        </form>
    </div>
</div>

<% include partials/footer %>
