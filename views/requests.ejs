<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-12">

    <!-- Page header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-h2 text-on-surface font-h2">Live Blood Requests</h1>
            <p class="text-body-md text-on-surface-variant mt-1">Open requests from people urgently needing blood donors</p>
        </div>
        <button onclick="openModal('post-request')"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-on-primary rounded-lg font-medium text-body-md hover:opacity-90 active:scale-95 transition-all shadow-md shadow-primary/20">
            <span class="material-symbols-outlined">add_circle</span>
            Post a Request
        </button>
    </div>

    <!-- Stats bar -->
    <div class="grid grid-cols-3 gap-3 mb-8">
        <%
        const criticalCount = requests.filter(r => r.urgency === 'critical').length;
        const urgentCount   = requests.filter(r => r.urgency === 'urgent').length;
        const normalCount   = requests.filter(r => r.urgency === 'normal').length;
        %>
        <div class="bg-red-50 border border-red-100 rounded-xl p-4 text-center">
            <p class="text-2xl font-extrabold text-primary"><%= criticalCount %></p>
            <p class="text-xs font-semibold text-primary uppercase tracking-wide mt-0.5">Critical</p>
        </div>
        <div class="bg-amber-50 border border-amber-100 rounded-xl p-4 text-center">
            <p class="text-2xl font-extrabold text-amber-700"><%= urgentCount %></p>
            <p class="text-xs font-semibold text-amber-700 uppercase tracking-wide mt-0.5">Urgent</p>
        </div>
        <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 text-center">
            <p class="text-2xl font-extrabold text-blue-700"><%= normalCount %></p>
            <p class="text-xs font-semibold text-blue-700 uppercase tracking-wide mt-0.5">Normal</p>
        </div>
    </div>

    <!-- Requests list -->
    <% if (requests.length === 0) { %>
        <div class="bg-white rounded-2xl border border-outline-variant shadow-sm p-16 text-center text-on-surface-variant">
            <span class="material-symbols-outlined text-5xl mb-3 block opacity-30">bloodtype</span>
            <p class="text-base font-medium">No open requests right now</p>
            <p class="text-sm mt-1">Be the first to post one if you need a donor</p>
            <button onclick="openModal('post-request')" class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white rounded-lg text-sm font-medium hover:opacity-90 transition">
                <span class="material-symbols-outlined text-base">add_circle</span> Post a Request
            </button>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% requests.forEach(function(req) {
                const urgencyStyles = {
                    critical: { badge: 'bg-primary text-white',    icon: 'emergency', border: 'border-red-200',   ring: 'ring-1 ring-red-200' },
                    urgent:   { badge: 'bg-amber-500 text-white',  icon: 'priority_high', border: 'border-amber-200', ring: 'ring-1 ring-amber-200' },
                    normal:   { badge: 'bg-blue-500 text-white',   icon: 'water_drop', border: 'border-blue-100',  ring: '' }
                };
                const s = urgencyStyles[req.urgency] || urgencyStyles.normal;
                const timeAgo = (function() {
                    const diff = Date.now() - new Date(req.createdAt).getTime();
                    const mins = Math.floor(diff / 60000);
                    if (mins < 60) return mins + 'm ago';
                    const hrs = Math.floor(mins / 60);
                    if (hrs < 24) return hrs + 'h ago';
                    return Math.floor(hrs / 24) + 'd ago';
                })();
            %>
            <div class="bg-white rounded-2xl border <%= s.border %> <%= s.ring %> shadow-sm hover:shadow-md transition-shadow p-5 flex flex-col gap-4">
                <!-- Top row -->
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0">
                            <span class="text-xl font-extrabold text-primary leading-none"><%= req.bloodGroup %></span>
                        </div>
                        <div>
                            <p class="font-semibold text-on-surface"><%= req.requesterName %></p>
                            <p class="text-xs text-on-surface-variant flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">location_on</span><%= req.city %>
                            </p>
                        </div>
                    </div>
                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold <%= s.badge %> flex-shrink-0">
                        <span class="material-symbols-outlined text-xs"><%= s.icon %></span>
                        <%= req.urgency.charAt(0).toUpperCase() + req.urgency.slice(1) %>
                    </span>
                </div>

                <!-- Details -->
                <% if (req.hospital) { %>
                    <p class="text-xs text-on-surface-variant flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">local_hospital</span><%= req.hospital %>
                    </p>
                <% } %>
                <% if (req.message) { %>
                    <p class="text-sm text-on-surface-variant bg-surface-container-low rounded-lg px-3 py-2 italic">"<%= req.message %>"</p>
                <% } %>

                <!-- Footer -->
                <div class="flex items-center justify-between mt-auto pt-2 border-t border-outline-variant">
                    <span class="text-xs text-on-surface-variant"><%= timeAgo %></span>
                    <a href="tel:<%= req.contactNumber %>"
                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-secondary text-on-secondary rounded-lg text-xs font-semibold hover:opacity-90 transition-colors">
                        <span class="material-symbols-outlined text-sm">call</span>
                        Contact
                    </a>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
</main>

<!-- Post Request Modal -->
<div id="post-request" class="fixed inset-0 z-[100] hidden">
    <div class="modal-overlay absolute inset-0 bg-black/50" onclick="closeModal('post-request')"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="modal-content-panel bg-white rounded-xl shadow-[0_12px_32px_rgba(0,0,0,0.15)] w-full max-w-lg p-8 relative z-10 max-h-[90vh] overflow-y-auto">
            <button onclick="closeModal('post-request')" class="absolute top-4 right-4 p-1 rounded-full hover:bg-surface-container-low transition-colors">
                <span class="material-symbols-outlined text-on-surface-variant">close</span>
            </button>
            <div class="text-center mb-6">
                <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                    <span class="material-symbols-outlined text-primary text-2xl">emergency</span>
                </div>
                <h2 class="text-h3 text-on-surface">Post a Blood Request</h2>
                <p class="text-body-md text-on-surface-variant mt-1">Help will reach you faster</p>
            </div>
            <form action="/requests/new" method="POST" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Your Name <span class="text-primary">*</span></label>
                        <input type="text" name="requesterName" required placeholder="Full name"
                            class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                    </div>
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Contact Number <span class="text-primary">*</span></label>
                        <input type="tel" name="contactNumber" required placeholder="Phone number"
                            class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Blood Group Needed <span class="text-primary">*</span></label>
                        <select name="bloodGroup" required class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                            <option value="">Select group</option>
                            <option>A1+</option><option>A1-</option><option>A2+</option><option>A2-</option>
                            <option>A+</option><option>A-</option><option>B+</option><option>B-</option>
                            <option>A1B+</option><option>A1B-</option><option>A2B+</option><option>A2B-</option>
                            <option>AB+</option><option>AB-</option><option>O+</option><option>O-</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-label-md text-on-surface-variant block">Urgency <span class="text-primary">*</span></label>
                        <select name="urgency" class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                            <option value="normal">Normal</option>
                            <option value="urgent">Urgent (Within 24h)</option>
                            <option value="critical">Critical (ASAP)</option>
                        </select>
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="text-label-md text-on-surface-variant block">City <span class="text-primary">*</span></label>
                    <input type="text" name="city" required placeholder="Your city"
                        class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                </div>
                <div class="space-y-1">
                    <label class="text-label-md text-on-surface-variant block">Hospital (optional)</label>
                    <input type="text" name="hospital" placeholder="Name of hospital"
                        class="w-full h-11 px-4 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all">
                </div>
                <div class="space-y-1">
                    <label class="text-label-md text-on-surface-variant block">Message (optional)</label>
                    <textarea name="message" rows="2" placeholder="Any additional details..."
                        class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg text-sm form-input-focus transition-all resize-none"></textarea>
                </div>
                <button type="submit"
                    class="w-full h-12 bg-primary text-on-primary rounded-lg font-label-md hover:opacity-90 active:scale-[0.98] transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">send</span>
                    Submit Request
                </button>
            </form>
        </div>
    </div>
</div>

<% include partials/footer %>
