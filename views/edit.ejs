<% include partials/header %>

<main class="max-w-[1280px] mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-10">
            <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-primary text-4xl">edit</span>
            </div>
            <h1 class="text-h1 text-on-surface mb-3">Edit Donor Profile</h1>
            <p class="text-body-md text-on-surface-variant">Update your information to help us connect you with those in need.</p>
        </div>

        <!-- Edit Form -->
        <div class="bg-white rounded-2xl shadow-lg border border-outline-variant overflow-hidden">
            <form action="/edit" id="_form" class="space-y-8" method="POST" enctype="multipart/form-data">
                <div class="p-6 md:p-10 space-y-6">
                    <!-- Basic Info -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">person</span>
                            Personal Information
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Name</label>
                                <input type="text" name="name" value="<%= donor.name %>" disabled class="w-full h-12 px-4 bg-surface-container-low/50 border-none rounded-lg text-body-md opacity-60 cursor-not-allowed">
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Username</label>
                                <input type="text" name="username" value="<%= donor.local.username %>" disabled class="w-full h-12 px-4 bg-surface-container-low/50 border-none rounded-lg text-body-md opacity-60 cursor-not-allowed">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Email Address</label>
                                <input type="email" id="email" name="email" value="<%= donor.email %>" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Contact Number</label>
                                <input type="tel" id="_phoneNumber" name="contactNumber" value="<%= donor.contactNumber %>" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">lock</span>
                            Password
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Password</label>
                                <input type="password" id="_password" name="password" placeholder="Enter password to save changes" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Confirm Password</label>
                                <input type="password" id="_confirmPassword" placeholder="Confirm your password" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Blood & Medical Info -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary">bloodtype</span>
                            Blood & Medical Information
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Blood Group</label>
                                <select name="bloodGroup" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                    <option value="">Select Blood Group</option>
                                    <option <%= donor.bloodGroup === 'A1+' ? 'selected' : '' %>>A1+</option>
                                    <option <%= donor.bloodGroup === 'A1-' ? 'selected' : '' %>>A1-</option>
                                    <option <%= donor.bloodGroup === 'A2+' ? 'selected' : '' %>>A2+</option>
                                    <option <%= donor.bloodGroup === 'A2-' ? 'selected' : '' %>>A2-</option>
                                    <option <%= donor.bloodGroup === 'B+' ? 'selected' : '' %>>B+</option>
                                    <option <%= donor.bloodGroup === 'B-' ? 'selected' : '' %>>B-</option>
                                    <option <%= donor.bloodGroup === 'A1B+' ? 'selected' : '' %>>A1B+</option>
                                    <option <%= donor.bloodGroup === 'A1B-' ? 'selected' : '' %>>A1B-</option>
                                    <option <%= donor.bloodGroup === 'A2B+' ? 'selected' : '' %>>A2B+</option>
                                    <option <%= donor.bloodGroup === 'A2B-' ? 'selected' : '' %>>A2B-</option>
                                    <option <%= donor.bloodGroup === 'AB+' ? 'selected' : '' %>>AB+</option>
                                    <option <%= donor.bloodGroup === 'AB-' ? 'selected' : '' %>>AB-</option>
                                    <option <%= donor.bloodGroup === 'O+' ? 'selected' : '' %>>O+</option>
                                    <option <%= donor.bloodGroup === 'O-' ? 'selected' : '' %>>O-</option>
                                    <option <%= donor.bloodGroup === 'A+' ? 'selected' : '' %>>A+</option>
                                    <option <%= donor.bloodGroup === 'A-' ? 'selected' : '' %>>A-</option>
                                </select>
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Last Donation Date</label>
                                <input type="date" name="dateOfLastDonation" value="<%= donor.dateOfLastDonation ? new Date(donor.dateOfLastDonation).toISOString().split('T')[0] : '' %>" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Date of Birth</label>
                                <input type="date" name="dob" value="<%= donor.dob ? new Date(donor.dob).toISOString().split('T')[0] : '' %>" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                            </div>
                            <div class="space-y-2">
                                <label class="text-label-md text-on-surface-variant block">Gender</label>
                                <select name="gender" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                    <option value="">Select Gender</option>
                                    <option value="M" <%= donor.gender === 'M' ? 'selected' : '' %>>Male</option>
                                    <option value="F" <%= donor.gender === 'F' ? 'selected' : '' %>>Female</option>
                                    <option value="O" <%= donor.gender === 'O' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-tertiary">location_on</span>
                            Location
                        </h3>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">City</label>
                            <select name="city" required class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                <option value="">Select City</option>
                                <% const cities = ['Agartala','Agra','Ahmedabad','Ahmednagar','Aizwal','Ajmer','Akola','Aligarh','Allahabad','Alwar','Ambala','Amravati','Amreli','Amritsar','Anand','Anantapur','Anklesvar','Anuppur','Araria','Arcot','Arrah','Aruppukkottai','Asansol','Ashok Nagar','Aurangabad','Azamgarh','Bahadurgarh','Baharampur','Bahraich','Balaghat','Balasore','Balia','Ballabhgarh','Ballarpur','Balrampur','Banda','Bangalore','Banswara','Bardhaman','Bareilly','Barmer','Barrackpur','Barwani','Beawar','Belgaum','Bellary','Bengaluru','Betul','Bhagalpur','Bhandara','Bharatpur','Bharuch','Bhavnagar','Bhilai Nagar','Bhimavaram','Bhiwandi','Bhopal','Bhubaneswar','Bhuj','Bidar','Bihar Sharif','Bikaner','Bilaspur','Bokaro Steel City','Bongaigaon','Bulandshahr','Buldana','Burhanpur','Buxar','Chandigarh','Chennai','Coimbatore','Cuttack','Dehradun','Delhi','Dhanbad','Dharwad','Dhule','Dibrugarh','Dispur','Durgapur','Ernakulam','Erode','Faridabad','Gandhinagar','Gangtok','Gaya','Ghaziabad','Goa Velha','Gorakhpur','Greater Noida','Gurgaon','Guwahati','Gwalior','Haridwar','Hisar','Howrah','Hubli','Hyderabad','Indore','Jabalpur','Jaipur','Jalandhar','Jammu','Jamshedpur','Jodhpur','Junagadh','Kakinada','Kanpur','Kochi','Kohima','Kolkata','Kota','Lucknow','Ludhiana','Madurai','Mangalore','Mumbai','Meerut','Moradabad','Mysore','Nagpur','Nainital','Nashik','Navi Mumbai','Nellore','New Delhi','Nizamabad','NOIDA','Patna','Pune','Raipur','Rajkot','Ranchi','Salem','Shillong','Shimla','Silchar','Siliguri','Srinagar','Surat','Thane','Thiruvananthapuram','Thrissur','Tiruchirappalli','Tirupathi','Udaipur','Varanasi','Vellore','Vijayawada','Visakhapatnam','Warangal']; cities.forEach(function(city) { %>
                                    <option value="<%= city %>" <%= donor.city === city ? 'selected' : '' %>><%= city %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-label-md text-on-surface-variant block">Address</label>
                            <textarea name="address" rows="3" required class="w-full px-4 py-3 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all resize-none"><%= donor.address %></textarea>
                        </div>
                    </div>

                    <!-- Profile Picture -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">add_a_photo</span>
                            Profile Picture
                        </h3>
                        <div class="flex items-center gap-4">
                            <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-outline-variant">
                                <% if(donor.profilePic) { %>
                                    <% var file = 'uploads/' + donor.profilePic; %>
                                    <img src="<%= file %>" alt="Current profile" class="w-full h-full object-cover">
                                <% } else { %>
                                    <div class="w-full h-full bg-surface-container flex items-center justify-center">
                                        <span class="material-symbols-outlined text-2xl text-outline-variant">person</span>
                                    </div>
                                <% } %>
                            </div>
                            <div class="flex-1">
                                <input type="file" name="profilePic" accept="image/*" class="w-full h-12 px-4 bg-surface-container-low border-none rounded-lg text-body-md form-input-focus transition-all">
                                <%= typeof msg != 'undefined' ? '<p class="text-caption text-error mt-1">' + msg + '</p>' : '' %>
                            </div>
                        </div>
                    </div>

                    <!-- Active Status -->
                    <div class="space-y-4">
                        <h3 class="text-h3 text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary">volunteer_activism</span>
                            Donation Status
                        </h3>
                        <div class="bg-surface-container-low rounded-lg p-5 border border-outline-variant">
                            <% if(donor.activeStatus != true) { %>
                                <div id="eligible_check_true" class="space-y-3">
                                    <p class="text-label-md text-on-surface font-semibold mb-3">Please confirm you are eligible to donate:</p>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk1" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">My hemoglobin is not less than 12.5 grams</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk2" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">I am free from acute respiratory diseases and skin diseases</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk3" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">I do not carry any disease transmissible by blood transfusion</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk4" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">I am not under medication for Malaria / Tuberculosis / Diabetes / Fits / Convulsions</span>
                                    </label>
                                    <p class="text-label-md text-on-surface font-semibold mb-3 mt-4">I have NOT suffered from:</p>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk5" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">Hepatitis B, C</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk6" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">AIDS</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk7" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">Cancer</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk8" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">Kidney disease</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="_chk9" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface-variant">Heart disease</span>
                                    </label>
                                    <label class="flex items-start gap-3 cursor-pointer mt-4">
                                        <input type="checkbox" id="_chk10" value="true" name="activeStatus" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface font-semibold">I confirm that I meet the above eligibility criteria and am available to donate.</span>
                                    </label>
                                </div>
                            <% } else { %>
                                <div id="eligible_check_false" class="space-y-3">
                                    <p class="text-label-md text-on-surface font-semibold mb-3">I am currently unable to donate because:</p>
                                    <label class="flex items-start gap-3 cursor-pointer">
                                        <input type="checkbox" id="check10" value="true" name="activeStatus" class="w-5 h-5 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary">
                                        <span class="text-body-md text-on-surface font-semibold">I am not able to donate blood at this time</span>
                                    </label>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="px-6 md:px-10 pb-10">
                    <div class="flex flex-wrap gap-4">
                        <button type="submit" class="flex-1 min-w-[200px] h-14 bg-primary text-on-primary rounded-lg font-label-md hover:opacity-90 active:scale-[0.99] transition-all duration-300 shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined">save</span>
                            Save Changes
                        </button>
                        <a href="/profile" class="inline-flex items-center px-8 py-4 bg-surface-container-low text-on-surface rounded-lg font-label-md hover:bg-surface-container transition-colors gap-2">
                            Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</main>

<% include partials/footer %>
